---
// Formulario de inscripción: una sola página con seis campos. Se usa en el banner y en #formulario.
import { Icon } from "astro-icon/components";
import { CONDICIONES_ACADEMICAS, DISTRITOS, NAVIDAD } from "../../config/navidad";

interface Props { uid: string; compact?: boolean }
const { uid, compact = false } = Astro.props;
const id = (n: string) => `${uid}-${n}`;
const input =
  "mt-1 w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-[15px] text-slate-900 outline-none transition placeholder:text-slate-500 focus:border-amber-400 focus:ring-4 focus:ring-amber-300/30 dark:border-slate-600 dark:bg-slate-900 dark:text-white";
const label = "text-sm font-semibold text-slate-800 dark:text-slate-100";
const err = "mt-1 hidden text-xs font-medium text-red-600 dark:text-red-400";
const check = "flex cursor-pointer items-start gap-3 text-xs leading-relaxed text-slate-700 dark:text-slate-200";
const link = "font-semibold text-[#1e3a8a] underline dark:text-amber-300";
---

<div data-nv-root class="relative">
  <form data-nv-form novalidate class:list={["rounded-[28px] border border-white/10 bg-white text-left shadow-2xl shadow-black/40 dark:bg-slate-800", compact ? "p-5 md:p-6" : "p-6 md:p-9"]}>
    {compact && <p class="mb-4 font-display text-xl font-bold text-[#0B1D3A] dark:text-white">Inscríbete gratis</p>}
    <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px]" />

    <div class="grid gap-3.5 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <label for={id("nombre")} class={label}>Nombres y apellidos</label>
        <input id={id("nombre")} name="nombre" type="text" autocomplete="name" maxlength="120" required class={input} />
        <p data-error="nombre" class={err}>Escribe tus nombres y apellidos.</p>
      </div>
      <div>
        <label for={id("dni")} class={label}>DNI</label>
        <input id={id("dni")} name="dni" type="text" inputmode="numeric" maxlength="8" required class={input} />
        <p data-error="dni" class={err}>El DNI tiene 8 dígitos.</p>
      </div>
      <div>
        <label for={id("celular")} class={label}>Celular</label>
        <input id={id("celular")} name="celular" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="15" required placeholder="9XX XXX XXX" class={input} />
        <p data-error="celular" class={err}>Son 9 dígitos y empieza con 9.</p>
      </div>
      <div class="sm:col-span-2">
        <label for={id("email")} class={label}>Correo electrónico</label>
        <input id={id("email")} name="email" type="email" autocomplete="email" maxlength="160" required class={input} />
        <p data-error="email" class={err}>Ingresa un correo válido.</p>
      </div>
      <div class:list={[compact && "sm:col-span-2 xl:col-span-1"]}>
        <label for={id("distrito")} class={label}>Distrito de residencia</label>
        <select id={id("distrito")} name="distrito" required class={input}>
          <option value="">Selecciona</option>
          {DISTRITOS.map((d) => <option value={d}>{d}</option>)}
        </select>
        <p data-error="distrito" class={err}>Selecciona tu distrito.</p>
      </div>
      <div class:list={[compact && "sm:col-span-2 xl:col-span-1"]}>
        <label for={id("condicion")} class={label}>Condición académica</label>
        <select id={id("condicion")} name="condicion" required class={input}>
          <option value="">Selecciona</option>
          {CONDICIONES_ACADEMICAS.map((c) => <option value={c}>{c}</option>)}
        </select>
        <p data-error="condicion" class={err}>Selecciona tu condición académica.</p>
      </div>
    </div>

    <div class="mt-4 space-y-3 rounded-2xl bg-slate-50 p-4 dark:bg-slate-900/60">
      <label class={check}>
        <input type="checkbox" name="declara" value="si" required class="mt-0.5 h-4 w-4 shrink-0 accent-amber-500" />
        <span>Declaro que soy mayor de 18 años y resido en Lima Metropolitana.</span>
      </label>
      <p data-error="declara" class={err}>Debes confirmar que cumples los requisitos.</p>
      <label class={check}>
        <input type="checkbox" name="acepta_bases" value="si" required class="mt-0.5 h-4 w-4 shrink-0 accent-amber-500" />
        <span>Acepto las <a href={NAVIDAD.urlBases} target="_blank" class={link}>bases del sorteo</a> y autorizo el uso de mis datos para administrarlo, según la <a href="/privacidad/#sorteo" target="_blank" class={link}>política de privacidad</a>.</span>
      </label>
      <p data-error="acepta_bases" class={err}>Debes aceptar las bases para participar.</p>
      <label class={check}>
        <input type="checkbox" name="acepta_promos" value="si" class="mt-0.5 h-4 w-4 shrink-0 accent-amber-500" />
        <span><strong>Opcional.</strong> Doy mi consentimiento previo, libre, informado, expreso e inequívoco, conforme a las leyes N.º 32323 y N.º 29733, para que Mate Fácil E.I.R.L. (Hispanotech) me envíe comunicaciones comerciales a mi correo y celular. Puedo revocarlo cuando quiera en informes@tesis-ia.com. No influye en el sorteo.</span>
      </label>
    </div>

    <button type="submit" class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-red-600 to-red-700 px-6 py-3.5 font-display text-sm font-bold uppercase tracking-wide text-white transition hover:from-red-500 hover:to-red-600 disabled:cursor-wait disabled:opacity-70">
      <Icon name="lucide:gift" class="h-5 w-5" /> <span class="submit-label">Quiero participar</span>
    </button>
    <p class="mt-3 text-xs text-slate-600 dark:text-slate-400">{NAVIDAD.costoEnvio}</p>
    <p data-status role="status" aria-live="polite" class="hidden"></p>
  </form>

  <!-- Se copia a la página solo después de un registro válido -->
  <template data-nv-ok>
    <div tabindex="-1" class="rounded-[28px] border border-amber-300/40 bg-white p-7 text-center shadow-2xl dark:bg-slate-800 md:p-9">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-emerald-700"><Icon is:inline name="lucide:circle-check" class="h-8 w-8" /></div>
      <h3 data-ok-titulo class="mt-4 font-display text-2xl font-bold text-[#0B1D3A] dark:text-white">Tu inscripción quedó registrada</h3>
      <p class="mt-2 text-slate-600 dark:text-slate-300">Tu código de participación es:</p>
      <p data-ok-codigo class="mx-auto mt-3 inline-block rounded-2xl border-2 border-dashed border-amber-400 bg-amber-50 px-6 py-3 font-display text-3xl font-bold tracking-widest text-[#0B1D3A] dark:bg-amber-400/10 dark:text-amber-300"></p>
      <p data-ok-correo class="mt-4 text-sm text-slate-600 dark:text-slate-300"></p>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Sorteo: {NAVIDAD.sorteoTexto}, {NAVIDAD.canalSorteo}.</p>
      <div data-ok-grupo class="mt-5 hidden">
        <p class="text-sm text-slate-600 dark:text-slate-300">Únete al grupo de WhatsApp para recibir el enlace de Zoom. Es opcional y no condiciona el premio; también te lo enviaremos por correo. Los demás miembros podrán ver tu número.</p>
        <a target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-2 rounded-full border-2 border-emerald-600 px-6 py-2.5 text-sm font-bold text-emerald-700 dark:text-emerald-300"><Icon is:inline name="simple-icons:whatsapp" class="h-4 w-4" /> Unirme al grupo</a>
      </div>
    </div>
  </template>
</div>

<script>
  const REGLAS: Record<string, (fd: FormData) => boolean> = {
    nombre: (fd) => { const n = String(fd.get("nombre")).trim(); return n.length >= 5 && n.includes(" "); },
    dni: (fd) => /^\d{8}$/.test(String(fd.get("dni"))),
    celular: (fd) => /^9\d{8}$/.test(String(fd.get("celular"))),
    email: (fd) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(String(fd.get("email")).trim()),
    distrito: (fd) => !!fd.get("distrito"),
    condicion: (fd) => !!fd.get("condicion"),
    declara: (fd) => !!fd.get("declara"),
    acepta_bases: (fd) => !!fd.get("acepta_bases"),
  };

  const mostrarExito = (nombre: string, json: any, foco: HTMLElement) => {
    document.querySelectorAll<HTMLElement>("[data-nv-root]").forEach((root) => {
      const ok = (root.querySelector("template[data-nv-ok]") as HTMLTemplateElement).content.firstElementChild!.cloneNode(true) as HTMLElement;
      ok.querySelector("[data-ok-titulo]")!.textContent = `¡Listo, ${nombre}! Tu inscripción quedó registrada`;
      ok.querySelector("[data-ok-codigo]")!.textContent = json.codigo;
      ok.querySelector("[data-ok-correo]")!.textContent = json.correo
        ? "Te enviamos la confirmación a tu correo. Revisa también Promociones y Spam."
        : "Guarda una captura de esta pantalla: no pudimos enviarte el correo de confirmación.";
      if (json.grupo) {
        const c = ok.querySelector<HTMLElement>("[data-ok-grupo]")!;
        c.classList.remove("hidden");
        c.querySelector("a")!.href = json.grupo;
      }
      const f = root.querySelector("form")!; f.classList.add("hidden"); f.after(ok); // no se elimina: contiene íconos compartidos
      if (root === foco) { ok.focus({ preventScroll: true }); ok.scrollIntoView({ behavior: "smooth", block: "center" }); }
    });
  };

  document.querySelectorAll<HTMLElement>("[data-nv-root]").forEach((root) => {
    const form = root.querySelector<HTMLFormElement>("[data-nv-form]")!;
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const btnLabel = form.querySelector(".submit-label")!;
    const showError = (n: string, show: boolean) => {
      form.querySelector(`[data-error="${n}"]`)?.classList.toggle("hidden", !show);
      const el = form.querySelector<HTMLInputElement>(`[name="${n}"]`);
      el?.classList.toggle("!border-red-500", show);
      el?.setAttribute("aria-invalid", String(show));
    };
    const setStatus = (t: string, error: boolean) => {
      status.textContent = t;
      status.className = "mt-3 rounded-xl px-4 py-3 text-sm " + (error ? "bg-red-50 text-red-700 dark:bg-red-950/40 dark:text-red-300" : "bg-amber-50 text-amber-900 dark:bg-amber-950/40 dark:text-amber-200");
    };
    form.addEventListener("input", (e) => showError((e.target as HTMLInputElement).name, false));
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      fd.set("dni", String(fd.get("dni")).replace(/\D/g, ""));
      let cel = String(fd.get("celular")).replace(/\D/g, "");
      if (cel.length === 11 && cel.startsWith("51")) cel = cel.slice(2);
      fd.set("celular", cel);
      const malos = Object.keys(REGLAS).filter((c) => { const mal = !REGLAS[c](fd); showError(c, mal); return mal; });
      if (malos.length) {
        setStatus("Revisa los campos marcados en rojo.", true);
        form.querySelector<HTMLElement>(`[name="${malos[0]}"]`)?.focus();
        return;
      }
      btn.disabled = true;
      btnLabel.textContent = "Registrando…";
      setStatus("Registrando tu participación…", false);
      try {
        const res = await fetch("https://tesis-ia.com/api/navidad.php", { method: "POST", body: fd, headers: { Accept: "application/json" } });
        const json = await res.json();
        if (json.ok) return mostrarExito(String(fd.get("nombre")).trim().split(" ")[0], json, root);
        Object.keys(json.fields || {}).forEach((k) => showError(k, true));
        setStatus(json.error || "Revisa los datos e inténtalo de nuevo.", !json.duplicado);
      } catch {
        setStatus("No pudimos registrar tu inscripción. Inténtalo de nuevo en unos minutos o escríbenos a informes@tesis-ia.com.", true);
      } finally {
        btn.disabled = false;
        btnLabel.textContent = "Quiero participar";
      }
    });
  });
</script>
