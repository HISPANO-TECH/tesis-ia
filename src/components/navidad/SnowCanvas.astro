---
// Nieve sobre toda la página: un único <canvas> fijo, sin bloquear clics.
// - Se pausa cuando la pestaña no está visible (ahorra batería/CPU).
// - Respeta prefers-reduced-motion y el botón "Nieve" (preferencia guardada).
// - Cantidad de copos proporcional al área de pantalla (menos en móviles).
---

<canvas id="nieve" aria-hidden="true" class="pointer-events-none fixed inset-0 z-[45] h-full w-full"></canvas>
<button
  id="nieve-toggle"
  type="button"
  aria-pressed="true"
  title="Activar o desactivar la nieve"
  aria-label="Activar o desactivar la nieve"
  class="fixed bottom-6 left-4 z-50 inline-flex items-center gap-1.5 rounded-full border border-white/20 bg-[#0B1D3A]/80 px-3 py-2 text-xs font-bold text-white shadow-lg backdrop-blur transition hover:bg-[#0B1D3A]"
>
  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v20M4.9 4.9l14.2 14.2M2 12h20M4.9 19.1 19.1 4.9" /><path d="m9 4 3 3 3-3M9 20l3-3 3 3M4 9l3 3-3 3M20 9l-3 3 3 3" /></svg>
  <span data-label class="hidden sm:inline">Nieve: sí</span>
</button>

<script>
  const canvas = document.getElementById("nieve") as HTMLCanvasElement | null;
  const btn = document.getElementById("nieve-toggle");
  const label = btn?.querySelector("[data-label]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  type Flake = { x: number; y: number; r: number; vy: number; vx: number; phase: number; a: number };

  let enabled = !reduced;
  try {
    const saved = localStorage.getItem("nieve");
    if (saved !== null) enabled = saved === "1";
  } catch {}

  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    let flakes: Flake[] = [];
    let w = 0, h = 0, dpr = 1, raf = 0, last = 0;

    const spawn = (anywhere: boolean): Flake => {
      const r = Math.random() * 2.6 + 0.8;
      return {
        x: Math.random() * w,
        y: anywhere ? Math.random() * h : -10,
        r,
        vy: 18 + r * 14 + Math.random() * 12, // px/s: los copos grandes caen más rápido (profundidad)
        vx: (Math.random() - 0.5) * 12,
        phase: Math.random() * Math.PI * 2,
        a: 0.45 + Math.random() * 0.45,
      };
    };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const target = Math.round(Math.min(160, (w * h) / 9000));
      while (flakes.length < target) flakes.push(spawn(true));
      flakes.length = target;
    };

    const draw = (t: number) => {
      const dt = Math.min((t - last) / 1000, 0.05);
      last = t;
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = "#ffffff";
      for (const f of flakes) {
        f.phase += dt * 1.2;
        f.y += f.vy * dt;
        f.x += (f.vx + Math.sin(f.phase) * 14) * dt;
        if (f.y > h + 10 || f.x < -20 || f.x > w + 20) Object.assign(f, spawn(false));
        ctx.globalAlpha = f.a;
        ctx.beginPath();
        ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(draw);
    };

    const start = () => {
      if (raf || !enabled || document.hidden) return;
      canvas.style.display = "";
      last = performance.now();
      raf = requestAnimationFrame(draw);
    };
    const stop = (clear = false) => {
      cancelAnimationFrame(raf);
      raf = 0;
      if (clear) { ctx.clearRect(0, 0, w, h); canvas.style.display = "none"; }
    };

    const sync = () => {
      btn?.setAttribute("aria-pressed", String(enabled));
      if (label) label.textContent = enabled ? "Nieve: sí" : "Nieve: no";
      enabled ? start() : stop(true);
    };

    resize();
    window.addEventListener("resize", resize, { passive: true });
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
    btn?.addEventListener("click", () => {
      enabled = !enabled;
      try { localStorage.setItem("nieve", enabled ? "1" : "0"); } catch {}
      sync();
    });
    sync();
  }
</script>
