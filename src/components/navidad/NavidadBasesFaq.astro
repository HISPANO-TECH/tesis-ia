---
import { Icon } from "astro-icon/components";
import { NAVIDAD, NAVIDAD_BASES, NAVIDAD_FAQ } from "../../config/navidad";
---

<section id="bases" class="bg-[#fffbeb] py-20 dark:bg-slate-900 md:py-24">
  <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-2">
    <div>
      <span class="reveal inline-flex items-center gap-2 rounded-full bg-[#0B1D3A] px-3 py-1 text-xs font-bold uppercase tracking-widest text-amber-300">
        <Icon name="lucide:scroll-text" class="h-3.5 w-3.5" /> Bases del sorteo
      </span>
      <h2 class="reveal mt-4 font-display text-3xl font-bold tracking-tight text-[#0B1D3A] dark:text-white md:text-4xl">Reglas claras, sorteo transparente</h2>
      <dl class="reveal mt-6 grid grid-cols-2 gap-3">
        <div class="rounded-2xl bg-white p-4 shadow-sm dark:bg-slate-800">
          <dt class="text-xs font-bold uppercase tracking-widest text-slate-500">Cierre de inscripciones</dt>
          <dd class="mt-1 font-display font-bold text-[#0B1D3A] dark:text-white">{NAVIDAD.cierreTexto}</dd>
        </div>
        <div class="rounded-2xl bg-white p-4 shadow-sm dark:bg-slate-800">
          <dt class="text-xs font-bold uppercase tracking-widest text-slate-500">Sorteo</dt>
          <dd class="mt-1 font-display font-bold text-[#0B1D3A] dark:text-white">{NAVIDAD.sorteoTexto}</dd>
        </div>
      </dl>
      <ol class="mt-6 space-y-3">
        {NAVIDAD_BASES.map((b, i) => (
          <li class="reveal flex gap-3 text-slate-700 dark:text-slate-300" style={`--reveal-delay:${i * 50}ms`}>
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-red-600 text-xs font-bold text-white">{i + 1}</span>
            <span class="pt-0.5 text-[15px] leading-relaxed">{b}</span>
          </li>
        ))}
      </ol>
    </div>

    <div id="faq-navidad">
      <span class="reveal inline-flex items-center gap-2 rounded-full bg-[#0B1D3A] px-3 py-1 text-xs font-bold uppercase tracking-widest text-amber-300">
        <Icon name="lucide:circle-help" class="h-3.5 w-3.5" /> Preguntas frecuentes
      </span>
      <h2 class="reveal mt-4 font-display text-3xl font-bold tracking-tight text-[#0B1D3A] dark:text-white md:text-4xl">¿Tienes dudas?</h2>
      <div class="mt-6 space-y-3">
        {NAVIDAD_FAQ.map((f, i) => (
          <details class="reveal group rounded-2xl border border-amber-200 bg-white p-5 shadow-sm open:shadow-md dark:border-slate-700 dark:bg-slate-800" style={`--reveal-delay:${i * 60}ms`} open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display font-bold text-[#0B1D3A] dark:text-white">
              {f.q}
              <Icon name="lucide:plus" class="h-5 w-5 shrink-0 text-red-600 transition group-open:rotate-45" />
            </summary>
            <p class="mt-3 text-[15px] leading-relaxed text-slate-600 dark:text-slate-300">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
