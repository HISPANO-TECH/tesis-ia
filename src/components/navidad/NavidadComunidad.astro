---
import { Icon } from "astro-icon/components";
import { NAVIDAD_COMUNIDAD } from "../../config/navidad";
---

<section id="comunidad" class="relative overflow-hidden bg-white py-20 dark:bg-slate-950 md:py-28">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <span class="reveal inline-flex items-center gap-2 rounded-full bg-[#1e3a8a] px-3 py-1 text-xs font-bold uppercase tracking-widest text-white">
        <Icon name="lucide:graduation-cap" class="h-3.5 w-3.5" /> Comunidad HispanoTech
      </span>
      <h2 class="reveal mt-4 font-display text-4xl font-bold leading-tight tracking-tight text-[#0B1D3A] dark:text-white md:text-5xl" style="--reveal-delay:80ms">
        {NAVIDAD_COMUNIDAD.titulo}
      </h2>
      <p class="reveal mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-300" style="--reveal-delay:140ms">
        {NAVIDAD_COMUNIDAD.texto}
      </p>
      <ul class="mt-8 grid gap-3">
        {NAVIDAD_COMUNIDAD.beneficios.map((b, i) => (
          <li class="reveal flex items-start gap-3" style={`--reveal-delay:${200 + i * 70}ms`}>
            <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">
              <Icon name="lucide:check" class="h-4 w-4" />
            </span>
            <span class="text-slate-700 dark:text-slate-200">{b}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="reveal reveal-right relative">
      <div class="tilt-3d relative mx-auto aspect-square max-w-[460px] rounded-[40px] bg-gradient-to-br from-[#0B1D3A] via-[#1e3a8a] to-[#274cab] p-8 shadow-2xl shadow-blue-950/30">
        <div aria-hidden="true" class="absolute inset-0 rounded-[40px] bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.18),transparent_55%)]"></div>
        <img
          src="/navidad/birrete-3d.webp"
          alt="Birrete de graduación 3D cubierto de nieve con una rama de acebo"
          width="800"
          height="800"
          loading="lazy"
          decoding="async"
          class="animate-float relative h-full w-full object-contain drop-shadow-[0_25px_30px_rgba(0,0,0,0.45)]"
        />
        <div class="absolute -bottom-5 left-6 right-6 rounded-2xl bg-white px-5 py-4 text-center shadow-xl dark:bg-slate-800">
          <p class="font-display text-sm font-bold text-[#0B1D3A] dark:text-white">Estudiantes · Egresados · Maestría · Doctorado</p>
        </div>
      </div>
    </div>
  </div>
</section>
