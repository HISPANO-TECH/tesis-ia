---
import { Icon } from "astro-icon/components";
import { NAVIDAD, NAVIDAD_CANASTA, NAVIDAD_NOTA_PREMIO } from "../../config/navidad";
---

<section id="premio" class="relative overflow-hidden bg-gradient-to-b from-[#fffbeb] to-white py-20 dark:from-slate-900 dark:to-slate-950 md:py-28">
  <!-- Luces de fondo -->
  <div aria-hidden="true" class="pointer-events-none absolute -left-32 top-10 h-80 w-80 rounded-full bg-red-300/30 blur-3xl dark:bg-red-900/30"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -right-24 bottom-0 h-96 w-96 rounded-full bg-amber-300/40 blur-3xl dark:bg-amber-700/20"></div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-6 lg:grid-cols-2">
    <div class="reveal reveal-left relative order-2 lg:order-1">
      <div class="tilt-3d relative mx-auto aspect-square w-full max-w-[560px]">
        <div aria-hidden="true" class="absolute inset-[12%] rounded-full bg-gradient-to-br from-red-500/25 via-amber-300/30 to-transparent blur-2xl"></div>
        <img
          src="/navidad/premio-canasta.webp"
          alt="Imagen referencial de una canasta navideña con lazo granate, junto al árbol de Navidad"
          width="1254"
          height="1254"
          loading="lazy"
          decoding="async"
          class="animate-float relative h-full w-full rounded-[32px] object-cover shadow-[0_30px_50px_rgba(127,29,29,0.35)]"
        />
        <div class="absolute -right-2 top-6 rotate-6 rounded-2xl bg-[#0B1D3A] px-4 py-3 text-center text-white shadow-xl sm:right-4">
          <span class="block font-display text-4xl font-bold leading-none text-amber-300">{NAVIDAD.totalCanastas}</span>
          <span class="text-[11px] font-bold uppercase tracking-widest">ganadores</span>
        </div>
      </div>
    </div>

    <div class="order-1 lg:order-2">
      <span class="reveal inline-flex items-center gap-2 rounded-full bg-red-600 px-3 py-1 text-xs font-bold uppercase tracking-widest text-white">
        <Icon name="lucide:gift" class="h-3.5 w-3.5" /> El premio
      </span>
      <h2 class="reveal mt-4 font-display text-4xl font-bold leading-tight tracking-tight text-[#0B1D3A] dark:text-white md:text-5xl" style="--reveal-delay:80ms">
        Una canasta llena de Navidad para <span class="text-red-600 dark:text-red-400">25 ganadores</span>
      </h2>
      <p class="reveal mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-300" style="--reveal-delay:140ms">
        Se sortean 25 canastas navideñas y regalos sorpresa. Cada canasta incluye productos navideños, entre ellos los siguientes.
      </p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {NAVIDAD_CANASTA.map((it, i) => (
          <li class="reveal flex gap-3 rounded-2xl border border-amber-200 bg-white/80 p-4 shadow-sm backdrop-blur transition hover:-translate-y-1 hover:shadow-lg dark:border-slate-700 dark:bg-slate-800/70" style={`--reveal-delay:${200 + i * 70}ms`}>
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-red-500 to-red-700 text-white shadow">
              <Icon name={it.icon} class="h-5 w-5" />
            </span>
            <div>
              <h3 class="font-display font-bold text-[#0B1D3A] dark:text-white">{it.titulo}</h3>
              <p class="text-sm text-slate-600 dark:text-slate-400">{it.texto}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="reveal mt-4 text-sm text-slate-600 dark:text-slate-300">{NAVIDAD_NOTA_PREMIO}</p>
    </div>
  </div>
</section>
