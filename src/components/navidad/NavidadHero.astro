---
import { Icon } from "astro-icon/components";
import { NAVIDAD, NAVIDAD_HERO, NAVIDAD_MEDIA } from "../../config/navidad";
import NavidadFormulario from "./NavidadFormulario.astro";
const { bannerVideo, bannerVideoMovil, bannerPoster } = NAVIDAD_MEDIA;
---

<section id="inicio-navidad" class="relative isolate overflow-hidden bg-[#050d22] text-white">
  <!-- Fondo del banner: video de marketing (NAVIDAD_MEDIA.bannerVideo). Mientras no exista, imagen fija. -->
  {bannerVideo ? (
    <video
      id="hero-video"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-[68%_center]"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={bannerPoster}
      aria-hidden="true"
    >
      {bannerVideoMovil && <source src={bannerVideoMovil} type="video/mp4" media="(max-width: 767px)" />}
      <source src={bannerVideo} type="video/mp4" />
    </video>
  ) : (
    <img
      src={bannerPoster}
      alt=""
      aria-hidden="true"
      width="1920"
      height="1080"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-[68%_center]"
    />
  )}
  <!-- Degradados para legibilidad del texto -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[#050d22] via-[#050d22]/80 to-transparent max-lg:via-[#050d22]/70 max-lg:to-[#050d22]/30"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-[#050d22] to-transparent"></div>

  <div class="mx-auto grid min-h-[calc(100svh-112px)] max-w-7xl items-center gap-10 px-6 py-12 md:py-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12">
    <div>
      <span class="reveal inline-flex items-center gap-2 rounded-full border border-amber-300/40 bg-amber-300/10 px-3 py-1 text-xs font-bold uppercase tracking-widest text-amber-300 backdrop-blur">
        <Icon name="lucide:sparkles" class="h-3.5 w-3.5" /> {NAVIDAD_HERO.eyebrow}
      </span>

      <h1 class="mt-5 font-display text-[44px] font-bold uppercase leading-[0.95] tracking-tight sm:text-6xl xl:text-7xl">
        <span class="split-letters block text-amber-300 drop-shadow-[0_4px_24px_rgba(245,158,11,0.35)]">25 Canastas</span>
        <span class="split-letters block">Navideñas</span>
      </h1>

      <p class="reveal mt-5 font-display text-xl font-bold leading-snug text-white sm:text-2xl" style="--reveal-delay:120ms">
        {NAVIDAD_HERO.subtitulo}
      </p>
      <p class="reveal mt-3 max-w-xl text-base leading-relaxed text-slate-200 sm:text-lg" style="--reveal-delay:180ms">
        {NAVIDAD_HERO.texto}
      </p>

      <ul class="reveal mt-5 flex flex-wrap gap-2" style="--reveal-delay:240ms">
        {NAVIDAD_HERO.chips.map((c, i) => (
          <li class:list={[
            "rounded-full px-3 py-1 text-sm font-semibold",
            i === 0 ? "bg-emerald-400/15 text-emerald-300 ring-1 ring-emerald-300/30" : "bg-white/10 text-white ring-1 ring-white/15",
          ]}>{c}</li>
        ))}
      </ul>

      <!-- Cuenta regresiva al sorteo -->
      <div class="reveal mt-8" style="--reveal-delay:300ms">
        <div id="countdown" data-target={NAVIDAD.fechaSorteo} class="mt-2 hidden grid-cols-4 max-w-md gap-2 sm:gap-3">
          {[["dias", "Días"], ["horas", "Horas"], ["min", "Min"], ["seg", "Seg"]].map(([k, l]) => (
            <div class="rounded-2xl border border-white/15 bg-white/[0.07] px-2 py-3 text-center backdrop-blur-md [transform:perspective(600px)_rotateX(8deg)]">
              <span data-cd={k} class="block font-display text-3xl font-bold tabular-nums text-white sm:text-4xl"></span>
              <span class="text-[11px] font-semibold uppercase tracking-widest text-slate-300">{l}</span>
            </div>
          ))}
        </div>
        <p class="mt-3 text-sm text-slate-300">
          <Icon name="lucide:calendar-days" class="mr-1 inline h-4 w-4 text-amber-300" />
          Sorteo: <strong class="text-white">{NAVIDAD.sorteoTexto}</strong>, {NAVIDAD.canalSorteo}.<br />Inscripciones hasta: <strong class="text-white">{NAVIDAD.cierreTexto}</strong>.<br />{NAVIDAD.costoEnvio} <a href={NAVIDAD.urlBases} class="font-bold text-amber-300 underline">Lee las bases</a>.
        </p>
      </div>
    </div>

    <!-- Formulario en el banner -->
    <div id="registro" class="reveal reveal-right scroll-mt-28 w-full lg:max-w-[500px] lg:justify-self-end" style="--reveal-delay:200ms">
      <NavidadFormulario uid="nvb" compact />
    </div>
  </div>

  <a href="#premio" aria-label="Ver el premio" class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 animate-bounce text-white/70 hover:text-white md:block">
    <Icon name="lucide:chevrons-down" class="h-7 w-7" />
  </a>
</section>

<script>
  // Cuenta regresiva
  const cd = document.getElementById("countdown");
  if (cd) {
    const target = new Date(cd.dataset.target || "").getTime();
    const set = (k: string, v: number) => {
      const el = cd.querySelector(`[data-cd="${k}"]`);
      if (el) el.textContent = String(v).padStart(2, "0");
    };
    const tick = () => {
      const diff = Math.max(0, target - Date.now());
      set("dias", Math.floor(diff / 864e5));
      set("horas", Math.floor((diff / 36e5) % 24));
      set("min", Math.floor((diff / 6e4) % 60));
      set("seg", Math.floor((diff / 1e3) % 60));
      if (diff > 0) setTimeout(tick, 1000);
    };
    if (!Number.isNaN(target)) { tick(); cd.classList.replace("hidden", "grid"); }
  }

  // Ahorro de datos / movimiento reducido: dejamos solo el póster.
  const v = document.getElementById("hero-video") as HTMLVideoElement | null;
  const conn = (navigator as any).connection;
  if (v && (window.matchMedia("(prefers-reduced-motion: reduce)").matches || conn?.saveData)) {
    v.removeAttribute("autoplay");
    v.pause();
    v.preload = "none";
  }
</script>
