---
import { Icon } from "astro-icon/components";
import NavidadFormulario from "./NavidadFormulario.astro";
import { FORM_TITULO } from "../../config/navidad";
---

<section id="formulario" class="relative scroll-mt-28 overflow-hidden bg-gradient-to-b from-[#0B1D3A] via-[#102a63] to-[#0B1D3A] py-20 md:py-28">
  <img src="/navidad/esferas-3d.webp" alt="" aria-hidden="true" width="800" height="800" loading="lazy" decoding="async"
    class="animate-float pointer-events-none absolute -left-20 top-24 hidden w-64 opacity-90 xl:block" />
  <img src="/navidad/regalos-3d.webp" alt="" aria-hidden="true" width="1000" height="1000" loading="lazy" decoding="async"
    class="animate-float pointer-events-none absolute -right-16 bottom-16 hidden w-72 opacity-90 xl:block" style="animation-delay:-2s" />

  <div class="relative mx-auto max-w-3xl px-6">
    <div class="text-center text-white">
      <span class="reveal inline-flex items-center gap-2 rounded-full bg-red-600 px-3 py-1 text-xs font-bold uppercase tracking-widest">
        <Icon name="lucide:clipboard-list" class="h-3.5 w-3.5" /> Inscripción gratuita
      </span>
      <h2 class="reveal mt-4 font-display text-3xl font-bold leading-tight tracking-tight md:text-[42px]" style="--reveal-delay:80ms">
        {FORM_TITULO}
      </h2>
      <p class="reveal mx-auto mt-3 max-w-xl text-slate-300" style="--reveal-delay:140ms">
        Completa seis campos y recibe tu <strong class="text-amber-300">código de participación</strong>.
      </p>
    </div>
    <div class="reveal mt-10" style="--reveal-delay:200ms">
      <NavidadFormulario uid="nv" />
    </div>
  </div>
</section>
