---
const whatsappHref = "https://api.whatsapp.com/send/?phone=51927580985&text=Hola%2C%20quiero%20contactarme%20para%20recibir%20informaci%C3%B3n%20sobre%20asesor%C3%ADa%20en%20tesis%20universitaria%20en%20Per%C3%BA.%20Vengo%20de%20tesis-ia.com%20-%20Pack%20IAs%20Investigador%20Pro&type=phone_number&app_absent=0";
---

<section id="inicio" class="relative overflow-hidden bg-gradient-to-br from-[#0B1D3A] via-[#1e3a8a] to-[#2a4b9f] dark:from-[#070f24] dark:via-[#0B1D3A] dark:to-[#1e3a8a]">
  <!-- decorativos dorados -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -right-20 top-10 h-[480px] w-[480px] rounded-full bg-amber-400/15 blur-[90px]"></div>
    <div class="absolute -left-20 bottom-0 h-[400px] w-[400px] rounded-full bg-blue-400/15 blur-[80px]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(245,158,11,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(245,158,11,0.06)_1px,transparent_1px)] bg-[size:44px_44px]"></div>
  </div>

  <div class="relative mx-auto grid max-w-7xl gap-8 px-6 py-14 md:grid-cols-[1.1fr_0.9fr] md:py-20 lg:gap-12 lg:py-24">
    <div class="reveal flex flex-col justify-center" style="--reveal-delay:80ms">
      <div class="inline-flex w-fit items-center gap-2 rounded-full border border-amber-400/30 bg-amber-400/15 px-3 py-1 text-xs font-semibold tracking-widest text-amber-200 backdrop-blur">
        <span class="h-2 w-2 rounded-full bg-amber-400 animate-pulse-soft"></span> PACK IAS INVESTIGADOR PRO
      </div>
      <h1 class="split-letters mt-4 font-display text-[34px] font-bold leading-[0.95] tracking-tight text-white md:text-[46px] lg:text-[52px]">
        Tu tesis <span class="text-amber-300">sin mitos</span>, con IA bien usada + asesor humano
      </h1>
      <p class="mt-4 max-w-[60ch] text-[17px] leading-relaxed text-blue-100/90">
        La sola aplicación de las IAs <strong class="text-amber-200">no garantiza</strong> un buen desarrollo de tu tesis. Te damos las IAs que sí acceden a bases académicas (Scopus y más), prompts, plantillas, videos y el criterio metodológico que el jurado espera.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <div class="flex items-center gap-2 rounded-2xl bg-white/10 px-4 py-2.5 text-sm font-medium text-white backdrop-blur border border-amber-400/20">
          <svg class="h-4 w-4 text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5l10 -10"/></svg> IAs con fuentes reales
        </div>
        <div class="flex items-center gap-2 rounded-2xl bg-white/10 px-4 py-2.5 text-sm font-medium text-white backdrop-blur border border-amber-400/20">
          <svg class="h-4 w-4 text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5l10 -10"/></svg> Protocolo de tu universidad
        </div>
        <div class="flex items-center gap-2 rounded-2xl bg-white/10 px-4 py-2.5 text-sm font-medium text-white backdrop-blur border border-amber-400/20">
          <svg class="h-4 w-4 text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5l10 -10"/></svg> Anti-plagio con criterio
        </div>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="/#planes" class="group rounded-full bg-amber-400 px-8 py-3.5 font-display text-sm font-bold uppercase tracking-wide text-[#0B1D3A] shadow-lg shadow-amber-900/20 transition hover:bg-amber-300">
          Ver planes desde $20/mes
        </a>
        <a href={whatsappHref} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border-2 border-amber-400/60 bg-white/5 px-6 py-3 font-display text-sm font-bold uppercase tracking-wide text-white backdrop-blur hover:bg-amber-400 hover:text-[#0B1D3A] hover:border-amber-400 transition">
          Hablar con asesor
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="mt-6 flex items-center gap-4 text-xs text-blue-200/70">
        <div class="flex -space-x-2">
          <span class="h-7 w-7 rounded-full border-2 border-[#0B1D3A] bg-amber-300 flex items-center justify-center text-[10px] font-bold text-[#0B1D3A]">T</span>
          <span class="h-7 w-7 rounded-full border-2 border-[#0B1D3A] bg-blue-200 flex items-center justify-center text-[10px] font-bold text-blue-900">I</span>
          <span class="h-7 w-7 rounded-full border-2 border-[#0B1D3A] bg-white flex items-center justify-center text-[10px] font-bold text-[#0B1D3A]">A</span>
        </div>
        <span>+1,200 tesistas usando el Pack · <strong class="text-amber-200">4.9/5</strong> satisfacción</span>
      </div>
    </div>

    <!-- Card visual -->
    <div class="reveal reveal-zoom relative flex items-center justify-center" style="--reveal-delay:180ms">
      <div class="relative w-full max-w-[520px]">
        <!-- glow dorado -->
        <div class="absolute -inset-4 -z-10 rounded-[32px] bg-amber-400/10 blur-2xl"></div>
        <div class="rounded-[28px] border border-amber-400/20 bg-white p-4 shadow-2xl dark:bg-slate-900 dark:border-slate-700">
          <!-- header mock -->
          <div class="flex items-center justify-between rounded-2xl bg-[#0B1D3A] px-4 py-3 text-white">
            <div class="flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-red-400"></span><span class="h-3 w-3 rounded-full bg-amber-400"></span><span class="h-3 w-3 rounded-full bg-emerald-400"></span>
            </div>
            <span class="font-display text-xs font-bold uppercase tracking-widest text-amber-300">tesis-ia.com · workspace</span>
            <span class="h-6 w-6 rounded-full bg-amber-400 flex items-center justify-center text-[10px] font-bold text-[#0B1D3A]">IA</span>
          </div>

          <div class="mt-4 grid gap-4">
            <div class="rounded-2xl border border-amber-100 bg-amber-50/50 p-4 dark:bg-slate-800 dark:border-slate-700">
              <div class="flex items-center justify-between">
                <h3 class="font-display text-sm font-bold text-slate-800 dark:text-white">Pack IAs Investigador Pro</h3>
                <span class="rounded-full bg-amber-400 px-2.5 py-1 text-[11px] font-bold text-[#0B1D3A]">ACTIVO</span>
              </div>
              <div class="mt-3 grid grid-cols-3 gap-2">
                <div class="rounded-xl bg-white p-3 text-center shadow-sm dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
                  <div class="text-[11px] font-bold uppercase tracking-wide text-[#1e3a8a]">Scopus</div><div class="text-xs text-slate-500">IAs</div>
                </div>
                <div class="rounded-xl bg-white p-3 text-center shadow-sm dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
                  <div class="text-[11px] font-bold uppercase tracking-wide text-amber-600">Turnitin</div><div class="text-xs text-slate-500">Safe</div>
                </div>
                <div class="rounded-xl bg-white p-3 text-center shadow-sm dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
                  <div class="text-[11px] font-bold uppercase tracking-wide text-[#0B1D3A]">SPSS/R</div><div class="text-xs text-slate-500">Stats</div>
                </div>
              </div>
              <div class="mt-3 h-2 rounded-full bg-slate-200 dark:bg-slate-700"><div class="h-2 w-[72%] rounded-full bg-gradient-to-r from-[#1e3a8a] to-amber-400"></div></div>
              <p class="mt-1 text-xs text-slate-500">Tu avance: 72% · Próximo: revisión de Capítulo III</p>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div class="rounded-2xl bg-gradient-to-br from-[#0B1D3A] to-[#1e3a8a] p-4 text-white border border-amber-400/20">
                <div class="text-xs font-bold uppercase tracking-widest text-amber-300">Sesión grupal</div>
                <div class="mt-1 font-display text-lg font-bold leading-none">Jueves 8PM</div>
                <div class="text-xs text-blue-100">Zoom · grabada</div>
              </div>
              <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:bg-slate-800 dark:border-slate-700">
                <div class="text-xs font-bold uppercase tracking-widest text-slate-500">Revisión</div>
                <div class="mt-1 font-display text-sm font-bold text-slate-900 dark:text-white">1 capítulo / mes</div>
                <div class="text-xs text-amber-600 font-semibold">+ feedback detallado</div>
              </div>
            </div>

            <div class="flex items-center gap-3 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 dark:bg-amber-950/30 dark:border-amber-800">
              <div class="flex h-8 w-8 items-center justify-center rounded-full bg-amber-400 text-[#0B1D3A] font-bold">!</div>
              <p class="text-xs leading-snug text-amber-900 dark:text-amber-200"><strong>Alerta:</strong> La IA sin método no pasa jurado. Nosotros te damos el método.</p>
            </div>
          </div>
        </div>

        <!-- floating badge -->
        <div class="animate-float absolute -right-2 -top-4 hidden rounded-2xl bg-amber-400 px-4 py-2 text-xs font-bold uppercase tracking-wide text-[#0B1D3A] shadow-lg sm:flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[#0B1D3A] animate-pulse-soft"></span> Asesoría humana incluida
        </div>
      </div>
    </div>
  </div>
</section>
