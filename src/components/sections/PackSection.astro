---
import { Icon } from "astro-icon/components";
import PackModal from "../ui/PackModal.astro";

// Pack IAs Investigador Pro: el contenido real del pack, agrupado en 4 bloques
// para que se entienda de un vistazo (sin aglutinar información).
const bloques = [
  {
    titulo: "IAs de redacción y razonamiento",
    resumen: "Para borradores, esquemas y análisis de tus capítulos.",
    icon: "lucide:brain",
    tools: [
      { name: "ChatGPT Pro y Plus", desc: "Borradores, esquemas y corrección de estilo", icon: "simple-icons:openai" },
      { name: "Claude Max", desc: "Lee capítulos completos y documentos largos", icon: "simple-icons:claude" },
      { name: "Gemini Pro y Ultra", desc: "Investigación asistida y trabajo con documentos", icon: "simple-icons:googlegemini" },
      { name: "SuperGrok Heavy y Pro", desc: "Razonamiento largo para discusión y argumentación", icon: "simple-icons:x" },
    ],
  },
  {
    titulo: "Búsqueda académica y lectura",
    resumen: "Para conseguir fuentes que existen, con DOI verificable.",
    icon: "lucide:search-check",
    tools: [
      { name: "Perplexity Pro", desc: "Búsqueda con citas y enlaces rastreables", icon: "simple-icons:perplexity" },
      { name: "NotebookLM Pro y Ultra", desc: "Tu biblioteca de PDFs respondiendo con citas", icon: "lucide:notebook-pen" },
      { name: "Scribd", desc: "Descarga de textos y documentos académicos", icon: "simple-icons:scribd" },
      { name: "Bases indexadas", desc: "Flujos hacia Scopus, SciELO, Redalyc y Scholar", icon: "lucide:database" },
    ],
  },
  {
    titulo: "Antiplagio y redacción limpia",
    resumen: "Para llegar a la entrega sin sustos de similitud.",
    icon: "lucide:shield-check",
    tools: [
      { name: "Turnitin", desc: "Reporte de similitud y detección de IA", icon: "lucide:file-search" },
      { name: "WriteHuman", desc: "Humanización de texto, uso ilimitado", icon: "lucide:wand" },
      { name: "QuillBot Premium", desc: "Parafraseo y corrección gramatical sin límite", icon: "lucide:pen-line" },
      { name: "Zotero y APA 7", desc: "Gestor de referencias + plantillas del kit", icon: "simple-icons:zotero" },
    ],
  },
  {
    titulo: "Sustentación, diseño y formación",
    resumen: "Para cerrar: diapositivas, gráficos y cursos.",
    icon: "lucide:presentation",
    tools: [
      { name: "Gamma Ultra", desc: "Diapositivas de sustentación con créditos renovables", icon: "lucide:layers" },
      { name: "Canva Pro", desc: "Figuras, tablas y diseño con IA", icon: "simple-icons:canva" },
      { name: "Udemy, Domestika y Platzi", desc: "Miles de cursos incluidos", icon: "simple-icons:udemy" },
      { name: "Prompts y plantillas", desc: "Biblioteca por capítulo + manuales y videos", icon: "lucide:list-checks" },
    ],
  },
];

const extras = [
  { label: "Soporte 24/7", icon: "lucide:headphones" },
  { label: "Sesiones Meet y asesorías", icon: "lucide:users" },
  { label: "Comunidad +400 investigadores", icon: "simple-icons:whatsapp" },
  { label: "Nuevas IAs incluidas sin costo extra", icon: "lucide:refresh-cw" },
];
---

<section id="pack" class="relative overflow-hidden bg-gradient-to-b from-white via-[#f6f8fc] to-[#fffbeb] py-16 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 md:py-24">
  <!-- decorativos suaves: dorado + azul sobre fondo claro -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -left-24 top-10 h-[420px] w-[420px] rounded-full bg-amber-200/40 blur-[110px] dark:bg-amber-500/10"></div>
    <div class="absolute -right-24 bottom-0 h-[380px] w-[380px] rounded-full bg-blue-200/50 blur-[100px] dark:bg-blue-500/10"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(30,58,138,0.045)_1px,transparent_1px),linear-gradient(to_bottom,rgba(30,58,138,0.045)_1px,transparent_1px)] bg-[size:48px_48px]"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6">
    <!-- Encabezado -->
    <div class="mx-auto max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-amber-300 bg-amber-100 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-amber-800 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-300">
        <span class="h-2 w-2 rounded-full bg-amber-500 animate-pulse-soft"></span> Incluido en los 3 planes
      </div>
      <h2 class="split-letters mt-4 font-display text-[30px] font-bold leading-none tracking-tight text-slate-900 dark:text-white md:text-[42px]">
        QUÉ ES EL <span class="text-[#1e3a8a] dark:text-amber-400">PACK IAS INVESTIGADOR PRO</span>
      </h2>
      <p class="mt-4 text-[17px] leading-relaxed text-slate-600 dark:text-slate-300">
        Un solo acceso con las <strong class="text-[#0B1D3A] dark:text-amber-200">IAs premium que un tesista realmente necesita</strong>: redacción, búsqueda académica, antiplagio y sustentación. Sin pagar 15 suscripciones por separado.
      </p>

      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <button
          type="button"
          data-pack-modal
          class="inline-flex items-center gap-2 rounded-full bg-[#0B1D3A] px-6 py-3 font-display text-sm font-bold uppercase tracking-wide text-white shadow-lg shadow-blue-950/20 transition hover:scale-[1.02] hover:bg-black dark:bg-amber-400 dark:text-[#0B1D3A] dark:hover:bg-amber-300"
        >
          <Icon name="lucide:sparkles" class="h-4 w-4" /> Ver promoción del Pack
        </button>
        <a href="/#planes" class="inline-flex items-center gap-2 rounded-full border-2 border-[#1e3a8a] px-6 py-3 font-display text-sm font-bold uppercase tracking-wide text-[#1e3a8a] transition hover:bg-[#1e3a8a] hover:text-white dark:border-amber-400/60 dark:text-amber-300 dark:hover:bg-amber-400 dark:hover:text-[#0B1D3A]">
          Ver planes
        </a>
      </div>
    </div>

    <!-- Métricas -->
    <div class="reveal mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-3 md:grid-cols-4">
      {[
        { n: "15+", t: "IAs premium" },
        { n: "1", t: "solo acceso" },
        { n: "+400", t: "investigadores" },
        { n: "24/7", t: "soporte" },
      ].map((m) => (
        <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3 text-center shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div class="font-display text-2xl font-bold leading-none text-[#1e3a8a] dark:text-amber-300">{m.n}</div>
          <div class="mt-1 text-[11px] font-semibold uppercase tracking-widest text-slate-500 dark:text-slate-400">{m.t}</div>
        </div>
      ))}
    </div>

    <!-- Bloques de herramientas -->
    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:gap-6">
      {bloques.map((b, i) => (
        <article
          class="reveal group rounded-[24px] border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900 dark:hover:border-amber-800/60"
          style={`--reveal-delay:${i * 80}ms`}
        >
          <div class="flex items-start gap-3">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-[#0B1D3A] text-amber-300 shadow-md">
              <Icon name={b.icon} class="h-5 w-5" />
            </span>
            <div>
              <h3 class="font-display text-[17px] font-bold leading-tight text-slate-900 dark:text-white">{b.titulo}</h3>
              <p class="mt-0.5 text-[13px] text-slate-500 dark:text-slate-400">{b.resumen}</p>
            </div>
          </div>

          <ul class="mt-5 grid gap-2.5">
            {b.tools.map((t) => (
              <li class="flex items-center gap-3 rounded-xl border border-slate-100 bg-slate-50 px-3 py-2.5 dark:border-slate-800 dark:bg-slate-950/50">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-white text-[#1e3a8a] dark:border-slate-700 dark:bg-slate-800 dark:text-amber-300">
                  <Icon name={t.icon} class="h-4 w-4" />
                </span>
                <div class="min-w-0">
                  <div class="truncate font-display text-[14px] font-bold text-slate-900 dark:text-white">{t.name}</div>
                  <div class="text-[12px] leading-snug text-slate-500 dark:text-slate-400">{t.desc}</div>
                </div>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <!-- Extras -->
    <div class="reveal mt-6 flex flex-wrap justify-center gap-2.5">
      {extras.map((e) => (
        <span class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-white px-4 py-2 text-[12px] font-semibold text-slate-700 shadow-sm dark:border-amber-800/60 dark:bg-slate-900 dark:text-slate-300">
          <Icon name={e.icon} class="h-3.5 w-3.5 text-amber-600 dark:text-amber-400" /> {e.label}
        </span>
      ))}
    </div>

    <!-- Cierre con anclaje de valor + CTA -->
    <div class="reveal mt-10 overflow-hidden rounded-[24px] bg-gradient-to-r from-amber-400 to-[#facc15] p-[1.5px] shadow-lg shadow-amber-900/10">
      <div class="flex flex-col items-center gap-5 rounded-[22px] bg-[#0B1D3A] px-6 py-7 text-center md:flex-row md:justify-between md:text-left">
        <div>
          <p class="font-display text-lg font-bold leading-snug text-white md:text-xl">
            Contratadas por separado superan los <span class="text-amber-300">US$300 al mes</span>.
          </p>
          <p class="mt-1.5 max-w-[70ch] text-sm leading-relaxed text-blue-100/80">
            Aquí las tienes todas en un solo plan, con kit metodológico y asesor humano incluidos <strong class="text-amber-200">desde US$20/mes</strong>. Comparativa referencial de precios de lista públicos.
          </p>
        </div>
        <div class="flex w-full shrink-0 flex-col gap-2 sm:w-auto sm:flex-row">
          <button
            type="button"
            data-pack-modal
            class="inline-flex items-center justify-center gap-2 rounded-full bg-amber-400 px-6 py-3 font-display text-sm font-bold uppercase tracking-wide text-[#0B1D3A] shadow-lg shadow-amber-900/20 transition hover:bg-amber-300"
          >
            Quiero el Pack <Icon name="lucide:arrow-right" class="h-4 w-4" />
          </button>
          <a href="/#planes" class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-amber-400/50 px-6 py-3 font-display text-sm font-bold uppercase tracking-wide text-white transition hover:bg-amber-400 hover:text-[#0B1D3A]">
            Ver planes
          </a>
        </div>
      </div>
    </div>

    <p class="mx-auto mt-5 max-w-3xl text-center text-[11px] leading-relaxed text-slate-400 dark:text-slate-500">
      Las marcas mencionadas pertenecen a sus respectivos titulares. El Pack IAs Investigador Pro entrega acceso a un workspace de herramientas y acompañamiento metodológico: es un servicio de asesoría y guía, no de suplantación académica.
    </p>
  </div>
</section>

<PackModal />
