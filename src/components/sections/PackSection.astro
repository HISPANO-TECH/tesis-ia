---
import { Icon } from "astro-icon/components";
import PackModal from "../ui/PackModal.astro";
import { PACK_CATEGORIAS, PACK_BENEFICIOS, IAS_LABEL } from "../../config/pack";
import { PLANES } from "../../config/planes";

// Las IAs concretas salen de src/config/pack.ts (misma fuente que el Hero).
// Cada bloque de abajo agrupa una o más categorías del Plan.
const iasDe = (...cats: string[]) =>
  cats.flatMap((c) => PACK_CATEGORIAS.find((x) => x.cat === c)?.ias ?? []);

// Plan IAs Investigador Pro: qué resuelve cada familia de herramientas y con
// qué IAs se resuelve, para que el tesista vea exactamente lo que recibe.
const bloques = [
  {
    titulo: "Redacción y razonamiento",
    resumen: "Para escribir capítulos que sí avanzan.",
    icon: "lucide:brain",
    ias: iasDe("Redacción"),
    tools: [
      { name: "Borradores por capítulo", desc: "Esquemas, redacción y corrección de estilo en minutos", icon: "lucide:file-text" },
      { name: "Lectura de documentos largos", desc: "Sube capítulos completos y recibe análisis, no resúmenes vacíos", icon: "lucide:book-open" },
      { name: "Razonamiento avanzado", desc: "Discute resultados y anticipa las preguntas del jurado", icon: "lucide:message-square-quote" },
      { name: "Versiones de pago, no gratuitas", desc: "Sin límites de mensajes ni respuestas recortadas", icon: "lucide:infinity" },
    ],
  },
  {
    titulo: "Búsqueda académica y lectura",
    resumen: "Para conseguir fuentes que existen, con DOI verificable.",
    icon: "lucide:search-check",
    ias: iasDe("Investiga"),
    tools: [
      { name: "Fuentes con cita rastreable", desc: "Cada referencia con su enlace y DOI comprobable", icon: "lucide:link" },
      { name: "Tu biblioteca de PDFs", desc: "Pregunta a tus propios documentos y recibe respuestas citadas", icon: "lucide:notebook-pen" },
      { name: "Acceso a textos completos", desc: "Documentos académicos sin quedarte en el resumen", icon: "lucide:file-search" },
      { name: "Bases indexadas", desc: "Flujos de búsqueda hacia Scopus, SciELO, Redalyc y Scholar", icon: "lucide:database" },
    ],
  },
  {
    titulo: "Antiplagio y redacción limpia",
    resumen: "Para llegar a la entrega sin sustos de similitud.",
    icon: "lucide:shield-check",
    ias: iasDe("Detecta", "Humaniza"),
    tools: [
      { name: "Reporte de similitud", desc: "Revisión antiplagio y detección de IA antes de entregar", icon: "lucide:scan-line" },
      { name: "Humanización de texto", desc: "Uso ilimitado para que tu redacción no suene a robot", icon: "lucide:wand" },
      { name: "Parafraseo y gramática", desc: "Sin límite de palabras ni de documentos", icon: "lucide:pen-line" },
      { name: "Referencias en APA 7", desc: "Gestor de citas + plantillas del kit metodológico", icon: "lucide:quote" },
    ],
  },
  {
    titulo: "Sustentación, diseño y formación",
    resumen: "Para cerrar: diapositivas, gráficos y cursos.",
    icon: "lucide:presentation",
    ias: iasDe("Sustenta"),
    tools: [
      { name: "Diapositivas de sustentación", desc: "Presentaciones listas con créditos renovables", icon: "lucide:layers" },
      { name: "Figuras, tablas y diseño", desc: "Gráficos y piezas visuales para tu documento", icon: "lucide:image" },
      { name: "Miles de cursos incluidos", desc: "Formación complementaria sin costo extra", icon: "lucide:graduation-cap" },
      { name: "Prompts y plantillas", desc: "Biblioteca por capítulo + manuales y videos", icon: "lucide:list-checks" },
    ],
  },
];

// Videos de presentación del Plan: se muestran encima del encabezado.
// Cargamos solo la miniatura y el iframe de YouTube se inserta al hacer clic,
// para no arrastrar el peso del reproductor en cada visita.
// Para sumar más videos basta con añadir otro objeto a este arreglo.
const videos = [
  {
    id: "vaVu_0vXXHk",
    titulo: "Plan IAs Investigador Pro en acción",
    desc: "Cómo trabajan las IAs académicas y el asesor humano en tu tesis",
  },
];

const extras = [
  { label: "Soporte 24/7", icon: "lucide:headphones" },
  { label: "Sesiones Meet y asesorías", icon: "lucide:users" },
  { label: "Comunidad +400 investigadores", icon: "simple-icons:whatsapp" },
  { label: "Nuevas IAs incluidas sin costo extra", icon: "lucide:refresh-cw" },
];

// Ahorro mensual para la fila de métricas: cuánto costaría armar por tu cuenta
// lo que el Plan entrega en un solo acceso (precios de lista, referenciales).
const costoSuelto = [180, 45, 50, 30, 25].reduce((s, p) => s + p, 0);
const precioPack = Number(PLANES[0].price);
const ahorroMes = costoSuelto - precioPack;
---

<section id="pack" class="relative overflow-hidden bg-gradient-to-b from-white via-[#f6f8fc] to-[#fffbeb] py-10 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900 md:py-16">
  <!-- decorativos suaves: dorado + azul sobre fondo claro -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -left-24 top-10 h-[420px] w-[420px] rounded-full bg-amber-200/40 blur-[110px] dark:bg-amber-500/10"></div>
    <div class="absolute -right-24 bottom-0 h-[380px] w-[380px] rounded-full bg-blue-200/50 blur-[100px] dark:bg-blue-500/10"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(30,58,138,0.045)_1px,transparent_1px),linear-gradient(to_bottom,rgba(30,58,138,0.045)_1px,transparent_1px)] bg-[size:48px_48px]"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6">
    <!-- Video(s) de presentación del Plan -->
    <div class="reveal mb-10 md:mb-12">
      <div class="text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-white px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-amber-700 shadow-sm dark:border-amber-800/60 dark:bg-slate-900 dark:text-amber-300">
          <Icon name="lucide:play" class="h-3.5 w-3.5" /> Míralo en video
        </span>
      </div>

      <div class={`mt-4 grid gap-4 ${videos.length > 1 ? "md:grid-cols-2" : "mx-auto max-w-4xl"}`}>
        {videos.map((v) => (
          <figure class="overflow-hidden rounded-[24px] border border-slate-200 bg-white shadow-lg dark:border-slate-800 dark:bg-slate-900">
            <div class="relative aspect-video w-full bg-[#0B1D3A]" data-video={v.id} data-video-title={v.titulo}>
              <button type="button" data-video-play class="group absolute inset-0 h-full w-full cursor-pointer" aria-label={`Reproducir video: ${v.titulo}`}>
                <img
                  src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
                  alt=""
                  width="480"
                  height="360"
                  loading="lazy"
                  class="h-full w-full object-cover opacity-90 transition duration-300 group-hover:scale-[1.02] group-hover:opacity-100"
                />
                <span class="absolute inset-0 bg-gradient-to-t from-[#0B1D3A]/70 via-[#0B1D3A]/10 to-transparent"></span>
                <span class="absolute left-1/2 top-1/2 flex h-16 w-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-amber-400 text-[#0B1D3A] shadow-xl transition group-hover:scale-110">
                  <Icon name="lucide:play" class="ml-1 h-7 w-7" />
                </span>
              </button>
              <noscript>
                <a href={`https://youtu.be/${v.id}`} target="_blank" rel="noopener" class="absolute inset-x-0 bottom-0 block bg-[#0B1D3A]/90 px-4 py-2 text-center text-xs font-bold text-amber-300">
                  Ver el video en YouTube
                </a>
              </noscript>
            </div>
            <figcaption class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
              <div class="min-w-0">
                <div class="font-display text-[15px] font-bold leading-snug text-slate-900 dark:text-white">{v.titulo}</div>
                <p class="mt-0.5 text-[12px] leading-snug text-slate-500 dark:text-slate-400">{v.desc}</p>
              </div>
              <button
                type="button"
                data-pack-modal
                class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-amber-400 px-4 py-2 font-display text-[11px] font-bold uppercase tracking-wide text-[#0B1D3A] transition hover:bg-amber-300"
              >
                Quiero el Plan <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
              </button>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>

    <!-- Encabezado -->
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="split-letters font-display text-[30px] font-bold leading-none tracking-tight text-slate-900 dark:text-white md:text-[42px]">
        QUÉ ES EL <span class="text-[#1e3a8a] dark:text-amber-400">PLAN IAS INVESTIGADOR PRO</span>
      </h2>
      <p class="mt-4 text-[17px] leading-relaxed text-slate-600 dark:text-slate-300">
        Un solo acceso con <strong class="text-[#0B1D3A] dark:text-amber-200">todas las IAs premium que un tesista realmente necesita</strong>: redacción, búsqueda académica, antiplagio y sustentación. Más kit metodológico y asesor humano. Sin pagar 15 suscripciones por separado.
      </p>

      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <button
          type="button"
          data-pack-modal
          class="inline-flex items-center gap-2 rounded-full bg-[#0B1D3A] px-6 py-3 font-display text-sm font-bold uppercase tracking-wide text-white shadow-lg shadow-blue-950/20 transition hover:scale-[1.02] hover:bg-black dark:bg-amber-400 dark:text-[#0B1D3A] dark:hover:bg-amber-300"
        >
          <Icon name="lucide:sparkles" class="h-4 w-4" /> Ver promoción del Plan
        </button>
        <a href="/#planes" class="inline-flex items-center gap-2 rounded-full border-2 border-[#1e3a8a] px-6 py-3 font-display text-sm font-bold uppercase tracking-wide text-[#1e3a8a] transition hover:bg-[#1e3a8a] hover:text-white dark:border-amber-400/60 dark:text-amber-300 dark:hover:bg-amber-400 dark:hover:text-[#0B1D3A]">
          Ver planes
        </a>
      </div>
    </div>

    <!-- Métricas -->
    <div class="reveal mx-auto mt-8 grid max-w-4xl grid-cols-2 gap-3 md:grid-cols-4">
      {[
        { n: IAS_LABEL, t: "IAs premium" },
        { n: "1", t: "solo acceso" },
        { n: `US$${ahorroMes}`, t: "de ahorro al mes" },
        { n: "+400", t: "investigadores" },
      ].map((m) => (
        <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3 text-center shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div class="font-display text-2xl font-bold leading-none text-[#1e3a8a] dark:text-amber-300">{m.n}</div>
          <div class="mt-1 text-[11px] font-semibold uppercase tracking-widest text-slate-500 dark:text-slate-400">{m.t}</div>
        </div>
      ))}
    </div>

    <!-- Bloques de herramientas -->
    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:gap-6">
      {bloques.map((b, i) => (
        <article
          class="reveal group rounded-[24px] border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900 dark:hover:border-amber-800/60"
          style={`--reveal-delay:${i * 80}ms`}
        >
          <div class="flex items-start gap-3">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-[#0B1D3A] text-amber-300 shadow-md">
              <Icon name={b.icon} class="h-5 w-5" />
            </span>
            <div>
              <h3 class="font-display text-[17px] font-bold leading-tight text-slate-900 dark:text-white">{b.titulo}</h3>
              <p class="mt-0.5 text-[13px] text-slate-500 dark:text-slate-400">{b.resumen}</p>
            </div>
          </div>

          {/* Las IAs concretas de este bloque, con el nombre resaltado */}
          <div class="mt-4 rounded-2xl border border-amber-200 bg-amber-50/70 px-3.5 py-3 dark:border-amber-500/30 dark:bg-amber-400/[0.07]">
            <div class="font-display text-[10px] font-bold uppercase tracking-widest text-amber-700 dark:text-amber-400">IAs incluidas</div>
            <div class="mt-2 flex flex-wrap gap-2">
              {b.ias.map((ia) => (
                <span class="inline-flex items-center gap-1.5 rounded-lg border border-amber-300 bg-white px-2.5 py-1 font-display text-[14px] font-bold leading-tight text-[#0B1D3A] shadow-sm dark:border-amber-500/50 dark:bg-slate-900 dark:text-amber-200">
                  <Icon name="lucide:sparkles" class="h-3 w-3 shrink-0 text-amber-500" /> {ia}
                </span>
              ))}
            </div>
          </div>

          <ul class="mt-4 grid gap-2.5">
            {b.tools.map((t) => (
              <li class="flex items-center gap-3 rounded-xl border border-slate-100 bg-slate-50 px-3 py-2.5 dark:border-slate-800 dark:bg-slate-950/50">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-white text-[#1e3a8a] dark:border-slate-700 dark:bg-slate-800 dark:text-amber-300">
                  <Icon name={t.icon} class="h-4 w-4" />
                </span>
                <div class="min-w-0">
                  <div class="font-display text-[14px] font-bold leading-snug text-slate-900 dark:text-white">{t.name}</div>
                  <div class="text-[12px] leading-snug text-slate-500 dark:text-slate-400">{t.desc}</div>
                </div>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <!-- Beneficios principales del Plan -->
    <div class="reveal mt-8">
      <div class="text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-white px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-amber-700 shadow-sm dark:border-amber-800/60 dark:bg-slate-900 dark:text-amber-300">
          <Icon name="lucide:award" class="h-3.5 w-3.5" /> Beneficios principales
        </span>
        <h3 class="mt-3 font-display text-[22px] font-bold leading-tight tracking-tight text-slate-900 dark:text-white md:text-[28px]">
          Lo que te llevas con el <span class="text-[#1e3a8a] dark:text-amber-400">Plan Investigador Pro</span>
        </h3>
      </div>

      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {PACK_BENEFICIOS.map((b) => (
          <div class="flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-amber-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-amber-800/60">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-amber-400 text-[#0B1D3A]">
              <Icon name={b.icon} class="h-4 w-4" />
            </span>
            <div class="min-w-0">
              <div class="font-display text-[15px] font-bold leading-snug text-slate-900 dark:text-white">{b.titulo}</div>
              <p class="mt-1 text-[12.5px] leading-snug text-slate-500 dark:text-slate-400">{b.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Extras -->
    <div class="reveal mt-6 flex flex-wrap justify-center gap-2.5">
      {extras.map((e) => (
        <span class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-white px-4 py-2 text-[12px] font-semibold text-slate-700 shadow-sm dark:border-amber-800/60 dark:bg-slate-900 dark:text-slate-300">
          <Icon name={e.icon} class="h-3.5 w-3.5 text-amber-600 dark:text-amber-400" /> {e.label}
        </span>
      ))}
    </div>
  </div>
</section>

<PackModal />

<script>
  // Fachada de YouTube: hasta que el visitante no pulsa play solo hay una
  // miniatura, así la portada no carga el reproductor (ni sus cookies).
  document.querySelectorAll("[data-video-play]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const caja = btn.closest("[data-video]");
      if (!caja) return;
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${caja.dataset.video}?autoplay=1&rel=0&modestbranding=1`;
      iframe.title = caja.dataset.videoTitle || "Video";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      iframe.className = "absolute inset-0 h-full w-full border-0";
      caja.replaceChildren(iframe);
    });
  });
</script>
