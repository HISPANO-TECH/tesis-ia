---
import { Icon } from "astro-icon/components";

const mitos = [
  {
    mito: '"La IA me escribe toda la tesis y solo la entrego."',
    realidad: "la IA genera texto genérico y sin datos propios; sin metodología ni análisis real, el jurado lo detecta al toque.",
    icon: "lucide:file-text",
  },
  {
    mito: '"Con IA ya no necesito asesor."',
    realidad: "la IA no conoce tu universidad y su protocolo, tu línea de investigación ni los criterios de tu jurado; eso solo te lo da un humano.",
    icon: "lucide:graduation-cap",
  },
  {
    mito: '"Si uso IA, Turnitin me va a marcar como plagio seguro."',
    realidad: "usada bien (parafraseo + humanización + referencias propias), reduces similitud; el problema es copiar y pegar sin criterio.",
    icon: "lucide:search",
  },
  {
    mito: '"Cualquier IA gratuita me sirve igual que una de pago."',
    realidad: "las gratuitas alucinan referencias y datos falsos; para papers reales necesitas IA con acceso a bases académicas (Scopus, etc.).",
    icon: "lucide:gem",
  },
  {
    mito: '"La IA entiende mi marco teórico con solo pedírselo."',
    realidad: "sin que tú le des la estructura y las fuentes correctas, arma un marco teórico superficial o inventado, incluso con fuentes irreales.",
    icon: "lucide:book-open",
  },
  {
    mito: '"Con IA termino mi tesis en un fin de semana."',
    realidad: "la IA acelera la redacción, pero la recolección de datos, el trabajo de campo, el análisis crítico, la metodología y las correcciones las debes trabajar tú o con un asesor.",
    icon: "lucide:clock-3",
  },
  {
    mito: '"La IA hace el análisis estadístico por mí."',
    realidad: "puede ayudarte a interpretar resultados, pero corres riesgo de errores graves si no sabes qué prueba corresponde a tu diseño. Debes entender los fundamentos para exponer ante jurado.",
    icon: "lucide:bar-chart-3",
  },
  {
    mito: '"Usar IA es hacer trampa."',
    realidad: "usarla como apoyo (redacción, organización, referencias) es tan válido como usar un gestor de citas; el problema es no pensar tú mismo el contenido ni revisarlo críticamente.",
    icon: "lucide:scale",
  },
  {
    mito: '"Todas las IAs detectan y evitan el plagio igual de bien."',
    realidad: "cada detector mide distinto; lo que pasa un detector puede fallar en el de tu universidad si no lo trabajas con criterio.",
    icon: "lucide:shield",
  },
  {
    mito: '"Una vez que uso IA, ya no necesito revisar nada."',
    realidad: 'siempre hay que verificar cada dato, cita y referencia que la IA sugiere — puede "alucinar" fuentes que no existen.',
    icon: "lucide:check-circle-2",
  },
];
---

<section id="mitos" class="bg-white py-10 dark:bg-slate-950 md:py-16">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-amber-50 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-amber-700 dark:bg-amber-950/40 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
        <span class="h-2 w-2 rounded-full bg-amber-500"></span> Desmitificando la IA
      </div>
      <h2 class="split-letters mt-4 font-display text-[30px] font-bold leading-none tracking-tight text-slate-900 dark:text-white md:text-[40px]">
        MITOS DE LA <span class="text-[#1e3a8a] dark:text-amber-400">APLICACIÓN DE IA</span> PARA TU TESIS
      </h2>
      <p class="mt-3 text-[16px] leading-relaxed text-slate-500 dark:text-slate-400">
        Conoce la verdad antes de caer en atajos que te cuestan la sustentación. La IA es potencia, pero sin método es riesgo.
      </p>
    </div>

    <div class="reveal relative mt-8" data-mitos-carousel aria-roledescription="carrusel" aria-label="Mitos sobre la IA en tu tesis">
      <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-white to-transparent dark:from-slate-950 sm:w-20"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-white to-transparent dark:from-slate-950 sm:w-20"></div>

      <div class="cursor-grab select-none overflow-hidden active:cursor-grabbing" data-mitos-viewport>
        <div class="flex w-max gap-5 will-change-transform" data-mitos-track>
          {[...mitos, ...mitos].map((m, i) => (
            <article
              class="group relative w-[280px] shrink-0 overflow-hidden rounded-[20px] border border-slate-200 bg-white p-6 shadow-sm transition hover:border-amber-200 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-amber-800/50 sm:w-[360px] lg:w-[420px]"
              aria-hidden={i >= mitos.length ? "true" : undefined}
            >
              <div class="absolute right-0 top-0 h-20 w-20 -translate-y-6 translate-x-6 rounded-full bg-amber-50 opacity-60 group-hover:bg-amber-100 dark:bg-amber-950/20"></div>
              <div class="relative">
                <div class="flex items-start gap-3">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#0B1D3A] text-amber-300">
                    <Icon name={m.icon} class="h-5 w-5" />
                  </span>
                  <h3 class="font-display text-[16px] font-bold leading-snug text-slate-900 dark:text-white">
                    Mito: <span class="font-semibold text-slate-700 dark:text-slate-200">{m.mito}</span>
                  </h3>
                </div>
                <div class="mt-3 flex gap-3 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 dark:border-amber-900/50 dark:bg-amber-950/20">
                  <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-amber-600" />
                  <p class="text-[14px] leading-relaxed text-slate-700 dark:text-slate-300">
                    <strong class="text-amber-700 dark:text-amber-400">Realidad:</strong> {m.realidad}
                  </p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="mt-6 flex items-center justify-center gap-3">
        <button
          type="button"
          data-mitos-prev
          aria-label="Mito anterior"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 transition hover:border-amber-300 hover:bg-amber-50 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-amber-800 dark:hover:bg-amber-950/30"
        >
          <Icon name="lucide:chevron-left" class="h-4 w-4" />
        </button>
        <span class="text-xs font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500">Arrastra o desliza</span>
        <button
          type="button"
          data-mitos-next
          aria-label="Mito siguiente"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 transition hover:border-amber-300 hover:bg-amber-50 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-amber-800 dark:hover:bg-amber-950/30"
        >
          <Icon name="lucide:chevron-right" class="h-4 w-4" />
        </button>
      </div>
    </div>

    <div class="reveal mt-8 rounded-[20px] bg-gradient-to-r from-[#0B1D3A] to-[#1e3a8a] p-[1px]">
      <div class="rounded-[19px] bg-gradient-to-r from-[#0B1D3A] to-[#1e3a8a] px-6 py-6 text-center sm:px-10 sm:py-8">
        <p class="font-display text-lg font-bold text-white sm:text-xl">
          “La IA no reemplaza tu criterio. <span class="text-amber-300">Lo potencia cuando sabes usarla.”</span>
        </p>
        <p class="mt-2 text-sm text-blue-100/80">Por eso el Plan Investigador Pro combina IAs premium + método + acompañamiento humano.</p>
        <a href="/#planes" class="mt-5 inline-flex items-center gap-2 rounded-full bg-amber-400 px-6 py-2.5 text-sm font-bold uppercase tracking-wide text-[#0B1D3A] hover:bg-amber-300">Quiero usar IA con método <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector("[data-mitos-carousel]");
  if (root) {
    const viewport = root.querySelector("[data-mitos-viewport]");
    const track = root.querySelector("[data-mitos-track]");
    const cards = Array.from(track.children);
    const total = cards.length / 2; // el set original, la otra mitad es el clon
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const VELOCIDAD = 40; // px por segundo del avance automático

    let offset = 0;
    let setW = 0;
    let paso = 0;
    let objetivo = null; // destino al usar las flechas
    let pausado = reduced;
    let arrastrando = false;
    let inicioX = 0;
    let inicioOffset = 0;
    let ultimo = 0;

    function medir() {
      setW = cards[total].offsetLeft - cards[0].offsetLeft;
      paso = cards[1].offsetLeft - cards[0].offsetLeft;
    }

    function normalizar(v) {
      if (!setW) return v;
      return ((v % setW) + setW) % setW;
    }

    function pintar() {
      track.style.transform = `translate3d(${-offset}px,0,0)`;
    }

    function frame(t) {
      const dt = ultimo ? Math.min((t - ultimo) / 1000, 0.05) : 0;
      ultimo = t;

      if (objetivo !== null) {
        const resto = objetivo - offset;
        if (Math.abs(resto) < 0.5) {
          offset = normalizar(objetivo);
          objetivo = null;
        } else {
          offset += resto * 0.12;
        }
        pintar();
      } else if (!pausado && !arrastrando) {
        offset = normalizar(offset + VELOCIDAD * dt);
        pintar();
      }

      requestAnimationFrame(frame);
    }

    function mover(dir) {
      const base = objetivo === null ? offset : objetivo;
      objetivo = base + dir * (paso || 300);
    }

    viewport.addEventListener("pointerdown", (e) => {
      arrastrando = true;
      objetivo = null;
      inicioX = e.clientX;
      inicioOffset = offset;
      viewport.setPointerCapture(e.pointerId);
    });
    viewport.addEventListener("pointermove", (e) => {
      if (!arrastrando) return;
      offset = normalizar(inicioOffset - (e.clientX - inicioX));
      pintar();
    });
    const soltar = (e) => {
      if (!arrastrando) return;
      arrastrando = false;
      if (e.pointerId !== undefined && viewport.hasPointerCapture(e.pointerId)) {
        viewport.releasePointerCapture(e.pointerId);
      }
    };
    viewport.addEventListener("pointerup", soltar);
    viewport.addEventListener("pointercancel", soltar);
    viewport.addEventListener("dragstart", (e) => e.preventDefault());

    root.querySelector("[data-mitos-prev]").addEventListener("click", () => mover(-1));
    root.querySelector("[data-mitos-next]").addEventListener("click", () => mover(1));

    // Pausamos el avance automático mientras el usuario mira o interactúa
    root.addEventListener("pointerenter", () => { if (!reduced) pausado = true; });
    root.addEventListener("pointerleave", () => { if (!reduced) pausado = false; });
    root.addEventListener("focusin", () => { pausado = true; });
    root.addEventListener("focusout", () => { if (!reduced) pausado = false; });

    window.addEventListener("resize", () => {
      medir();
      offset = normalizar(offset);
      pintar();
    });

    medir();
    pintar();
    requestAnimationFrame(frame);
  }
</script>
