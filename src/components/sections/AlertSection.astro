---
import { Icon } from "astro-icon/components";
---

<section id="alerta" class="bg-[#fffbeb] py-10 dark:bg-slate-900">
  <div class="mx-auto max-w-7xl px-6">
    <div class="reveal flex flex-col items-center gap-4 rounded-[24px] border border-amber-300 bg-gradient-to-r from-amber-400 to-[#facc15] px-6 py-6 shadow-lg sm:flex-row sm:gap-6 dark:border-amber-700 dark:from-amber-500 dark:to-amber-400">
      <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-[#0B1D3A] text-amber-400 shadow">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.3L2 21h20L13.7 3.3a1.8 1.8 0 0 0-3.4 0Z"/></svg>
      </div>
      <div class="text-center sm:text-left">
        <h2 class="font-display text-xl font-bold uppercase tracking-wide leading-none text-[#0B1D3A] sm:text-2xl">¡ALERTA!</h2>
        <p class="mt-1 max-w-[80ch] font-body text-[15px] font-semibold leading-snug text-[#0B1D3A]">
          La sola aplicación de las IAs <span class="underline decoration-[#0B1D3A] underline-offset-4">no garantiza</span> un buen desarrollo de tu tesis. Sin metodología, datos propios y criterio del jurado, no hay sustentación que aguante.
        </p>
      </div>
      <a href="/#mitos" class="shrink-0 inline-flex items-center gap-2 rounded-full bg-[#0B1D3A] px-6 py-3 font-display text-xs font-bold uppercase tracking-wide text-white hover:bg-black whitespace-nowrap">
        Ver mitos <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
