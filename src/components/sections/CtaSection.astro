---
import { Icon } from "astro-icon/components";
const whatsappHref = "https://api.whatsapp.com/send/?phone=51992005096&text=Hola%2C%20quiero%20contactarme%20para%20recibir%20informaci%C3%B3n%20sobre%20asesor%C3%ADa%20en%20tesis%20universitaria%20en%20Per%C3%BA.%20Vengo%20de%20tesis-ia.com%20-%20Pack%20IAs%20Investigador%20Pro%20y%20quiero%20avanzar%20mi%20tesis%20de%20forma%20integral&type=phone_number&app_absent=0";
---

<section class="relative overflow-hidden bg-gradient-to-br from-[#0B1D3A] via-[#1e3a8a] to-[#243ea8] py-10 dark:from-[#070f24] dark:via-[#0B1D3A] dark:to-[#1e3a8a] md:py-14">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -right-20 top-0 h-[400px] w-[400px] rounded-full bg-amber-400/15 blur-3xl"></div>
    <div class="absolute -left-20 bottom-0 h-[300px] w-[300px] rounded-full bg-white/5 blur-3xl"></div>
  </div>
  <span class="pointer-events-none absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2 select-none font-display text-[10rem] font-bold tracking-tight leading-none text-white/5 lg:block">TESIS IA</span>

  <div class="relative mx-auto max-w-4xl px-6 text-center">
    <div class="inline-flex items-center gap-2 rounded-full bg-amber-400/15 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-amber-300 backdrop-blur border border-amber-400/20">
      <span class="h-2 w-2 rounded-full bg-amber-400 animate-pulse-soft"></span> Cupos con seguimiento personalizado
    </div>
    <h2 class="mt-4 font-display text-[30px] font-bold leading-none tracking-tight text-white md:text-[44px]">
      ¿LISTO PARA AVANZAR TU TESIS <span class="text-amber-300">DE FORMA INTEGRAL?</span>
    </h2>
    <p class="mx-auto mt-4 max-w-[60ch] text-[16px] leading-relaxed text-blue-100">
      No dejes tu tesis a la suerte de una IA genérica. Usa el Pack IAs Investigador Pro con método, plantillas y asesor que conoce tu protocolo.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a href={whatsappHref} target="_blank" rel="noopener" class="group inline-flex items-center gap-2 rounded-full bg-amber-400 px-8 py-4 font-display text-sm font-bold uppercase tracking-wide text-[#0B1D3A] shadow-xl shadow-amber-900/20 hover:bg-amber-300 transition">
        Adquiere tu plan ahora <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
      <a href="/#planes" class="rounded-full border-2 border-amber-400/50 px-7 py-3 font-display text-sm font-bold uppercase tracking-wide text-amber-200 hover:bg-amber-400 hover:text-[#0B1D3A] hover:border-amber-400 transition">Comparar planes</a>
    </div>

    <div class="mt-6 flex flex-wrap justify-center gap-4 text-xs font-medium text-blue-200/70">
      <span class="flex items-center gap-1.5"><Icon name="lucide:check" class="h-4 w-4 text-amber-300" /> Acceso inmediato</span>
      <span class="flex items-center gap-1.5"><Icon name="lucide:check" class="h-4 w-4 text-amber-300" /> Garantía de acompañamiento</span>
      <span class="flex items-center gap-1.5"><Icon name="lucide:check" class="h-4 w-4 text-amber-300" /> Cancela cuando quieras</span>
    </div>
  </div>
</section>
