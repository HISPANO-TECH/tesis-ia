---
import { Icon } from "astro-icon/components";

const regiones = [
  { nombre: "Lima Metropolitana", detalle: "Lima, Callao, Barranca, Cañete", icon: "lucide:building-2" },
  { nombre: "Costa Norte", detalle: "Trujillo, Chiclayo, Piura, Chimbote", icon: "lucide:waves" },
  { nombre: "Costa Sur", detalle: "Arequipa, Tacna, Ica, Moquegua", icon: "lucide:sun" },
  { nombre: "Sierra Centro-Sur", detalle: "Cusco, Huancayo, Ayacucho, Huánuco", icon: "lucide:mountain" },
  { nombre: "Selva y Oriente", detalle: "Iquitos, Pucallpa, Tarapoto, Cajamarca", icon: "lucide:trees" },
  { nombre: "Norte Andino", detalle: "Cajamarca, Huaraz, Jaén", icon: "lucide:map-pinned" },
];

const universidades = [
  "UNMSM", "UNI", "PUCP", "USMP", "UCV", "UPC", "UTP", "UNSA", "UNT", "UNSAAC", "UContinental", "UCSS", "UNFV", "UPN", "Científica del Sur", "USIL"
];

const niveles = [
  { t: "Pregrado", d: "Proyecto, desarrollo y sustentación con guía paso a paso." },
  { t: "Maestría", d: "Marco teórico con fuentes reales y análisis con criterio." },
  { t: "Doctorado", d: "Acompañamiento en rigor metodológico y defensa ante jurado." },
  { t: "Título profesional", d: "Modalidad tesis o suficiencia con plantillas validadas." },
];
---

<section id="cobertura" class="relative overflow-hidden bg-[#0B1D3A] py-16 dark:bg-[#070f24] md:py-20">
  <div class="absolute inset-0">
    <img src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?w=1600&q=80&auto=format&fit=crop" alt="Perú universidades" class="parallax-peru h-full w-full object-cover opacity-20 scale-105" />
    <div class="absolute inset-0 bg-gradient-to-b from-[#0B1D3A]/85 via-[#0B1D3A]/70 to-[#1e3a8a]/90"></div>
    <div id="peru-shine" class="absolute inset-0 opacity-0 transition duration-500" style="background: radial-gradient(800px circle at var(--mx,50%) var(--my,30%), rgba(245,158,11,0.15), transparent 45%);"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-amber-400 px-3 py-1 text-xs font-bold uppercase tracking-widest text-[#0B1D3A]">
        <Icon name="lucide:map-pinned" class="h-3.5 w-3.5" /> Cobertura nacional
      </div>
      <h2 class="mt-4 font-display text-[28px] font-bold leading-none tracking-tight text-white md:text-[38px]">
        Acompañamiento <span class="text-amber-300">en todo el Perú</span>, con criterio de tu universidad
      </h2>
      <p class="mt-3 text-blue-100/80">
        No hacemos tu tesis por ti. Te <strong class="text-amber-200">guiamos con método, IAs verificadas y revisión humana</strong> adaptada al protocolo de tu escuela. Ético, trazable y defendible ante jurado.
      </p>
      <div class="mt-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1.5 text-xs font-medium text-amber-200 border border-white/10 backdrop-blur">
        <Icon name="lucide:shield-check" class="h-3.5 w-3.5" /> Enfoque ético: asesoría y capacitación, no suplantación académica
      </div>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {regiones.map((r, i) => (
        <div class="reveal group relative overflow-hidden rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur transition hover:bg-white/10 hover:border-amber-400/30" style={`--reveal-delay:${i*60}ms`}>
          <div class="shine absolute inset-0 opacity-0 group-hover:opacity-100 transition" style="background: radial-gradient(400px circle at var(--mx,50%) var(--my,50%), rgba(245,158,11,0.18), transparent 40%);"></div>
          <div class="relative flex items-start gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-400 text-[#0B1D3A]"><Icon name={r.icon} class="h-5 w-5" /></span>
            <div>
              <div class="text-sm font-bold text-white">{r.nombre}</div>
              <div class="text-xs leading-snug text-blue-200/70">{r.detalle}</div>
            </div>
          </div>
          <div class="relative mt-3 text-xs font-medium text-amber-200/80">Atención remota · Sesiones por Zoom · Material grabado</div>
        </div>
      ))}
    </div>

    <div class="reveal mt-12 rounded-[20px] border border-amber-400/20 bg-white p-6 dark:bg-slate-900 md:p-8">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h3 class="font-display text-lg font-bold tracking-tight text-[#0B1D3A] dark:text-white">Protocolos universitarios que acompañamos</h3>
          <p class="mt-1 max-w-2xl text-sm text-slate-600 dark:text-slate-400">Adaptamos plantillas, estructura y criterios de evaluación a tu reglamento. Tú mantienes la autoría; nosotros aportamos orden, fuentes verificadas y feedback.</p>
        </div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800"> <Icon name="lucide:graduation-cap" class="h-3.5 w-3.5" /> +30 universidades</span>
      </div>
      <div class="mt-5 flex flex-wrap gap-2">
        {universidades.map((u) => (
          <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:border-slate-700 dark:text-slate-300">{u}</span>
        ))}
        <span class="rounded-full bg-[#0B1D3A] px-3 py-1.5 text-xs font-bold text-amber-300">y más · consulta tu escuela</span>
      </div>
      <p class="mt-3 text-xs text-slate-500">Mención informativa de compatibilidad. No implica vínculo oficial con las universidades.</p>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-4">
      {niveles.map((n) => (
        <div class="reveal rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur">
          <div class="text-sm font-bold text-amber-300">{n.t}</div>
          <div class="mt-1 text-xs leading-relaxed text-blue-100/80">{n.d}</div>
        </div>
      ))}
    </div>

    <div class="reveal mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/#contacto" class="inline-flex items-center gap-2 rounded-full bg-amber-400 px-6 py-3 text-sm font-bold uppercase tracking-wide text-[#0B1D3A] hover:bg-amber-300">Consulta tu caso <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
      <a href="/blog" class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-6 py-3 text-sm font-bold uppercase tracking-wide text-white hover:bg-white/10">Ver guías por carrera <Icon name="lucide:book-open" class="h-4 w-4" /></a>
    </div>

    <p class="mx-auto mt-6 max-w-3xl text-center text-[11px] leading-relaxed text-blue-200/50">
      Wording cuidado para cumplimiento: usamos “asesoría”, “acompañamiento metodológico”, “guía”, “revisión” y “capacitación”. No ofrecemos redacción suplantada ni “tesis lista”. Todo el contenido es formativo y el estudiante mantiene autoría y responsabilidad académica.
    </p>
  </div>
</section>

<script>
  const sec = document.getElementById("cobertura");
  const shine = document.getElementById("peru-shine");
  const bg = document.querySelector(".parallax-peru");
  if (sec && shine) {
    sec.addEventListener("mousemove", (e) => {
      const rect = sec.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      shine.style.setProperty("--mx", `${x}%`);
      shine.style.setProperty("--my", `${y}%`);
      shine.style.opacity = "1";
    });
    sec.addEventListener("mouseleave", () => (shine.style.opacity = "0"));
  }
  document.querySelectorAll("#cobertura .group").forEach((card) => {
    card.addEventListener("mousemove", (e) => {
      const rect = card.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      card.style.setProperty("--mx", `${x}%`);
      card.style.setProperty("--my", `${y}%`);
    });
  });
  if (bg && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    window.addEventListener("scroll", () => {
      const rect = sec.getBoundingClientRect();
      const y = (window.scrollY - sec.offsetTop) * 0.12;
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        bg.style.transform = `translateY(${y}px) scale(1.05)`;
      }
    }, { passive: true });
  }
</script>
