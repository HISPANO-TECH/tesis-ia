---
const year = 2026;
---

<footer class="bg-[#0B1D3A] text-blue-100 dark:bg-[#070f24]">
  <div class="h-1 w-full bg-gradient-to-r from-[#1e3a8a] via-amber-400 to-[#facc15]"></div>
  <div class="mx-auto max-w-[1440px] px-6 py-12 lg:px-8 lg:py-14">
