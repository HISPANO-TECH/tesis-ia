---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import AlertSection from "../components/sections/AlertSection.astro";
import MitosSection from "../components/sections/MitosSection.astro";
import PackSection from "../components/sections/PackSection.astro";
import PlanesSection from "../components/sections/PlanesSection.astro";
import CtaSection from "../components/sections/CtaSection.astro";
import TestimoniosSection from "../components/sections/TestimoniosSection.astro";
import BlogSection from "../components/sections/BlogSection.astro";
import FormSection from "../components/sections/FormSection.astro";
import SeoPeruSection from "../components/sections/SeoPeruSection.astro";
import FaqSection from "../components/sections/FaqSection.astro";
import { SITE } from "../site.config";

const productLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Pack IAs Investigador Pro",
  description: SITE.description,
  brand: { "@type": "Brand", name: "Tesis IA" },
  offers: [
    { "@type": "Offer", name: "Plan Impulso", price: "20", priceCurrency: "USD", availability: "https://schema.org/InStock", url: `${SITE.url}#planes` },
    { "@type": "Offer", name: "Plan Avance", price: "35", priceCurrency: "USD", availability: "https://schema.org/InStock", url: `${SITE.url}#planes` },
    { "@type": "Offer", name: "Plan Graduación", price: "49", priceCurrency: "USD", availability: "https://schema.org/InStock", url: `${SITE.url}#planes` },
  ],
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.9", reviewCount: "127" },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [{ "@type": "ListItem", position: 1, name: "Inicio", item: SITE.url }],
};
---

<Layout
  title="Pack IAs Investigador Pro — Tesis sin mitos, con IA + asesor humano"
  description="La sola aplicación de las IAs no garantiza tu tesis. Con el Pack IAs Investigador Pro obtienes IAs académicas (Scopus), prompts, plantillas y asesoría para sustentar con confianza. Planes desde $20/mes."
  jsonLd={[productLd, breadcrumbLd]}
>
  <Hero />
  <PackSection />
  <AlertSection />
  <MitosSection />
  <PlanesSection />
  <TestimoniosSection />
  <BlogSection />
  <SeoPeruSection />
  <FormSection />
  <CtaSection />
  <FaqSection />

  <!-- SEO text block - azul + dorado -->
  <section class="border-t border-amber-100 bg-[#fffbeb] py-10 dark:border-slate-800 dark:bg-slate-900">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h2 class="font-display text-lg font-bold tracking-tight text-[#0B1D3A] dark:text-white">¿Por qué tesis-ia.com?</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
        Somos el punto de encuentro entre <strong>inteligencia artificial aplicada con rigor</strong> y la <strong>metodología que exige tu universidad peruana</strong>. No vendemos atajos: damos herramientas reales (IAs con acceso a literatura, gestores de referencias, apoyo estadístico) y el criterio para que tu jurado valide tu trabajo. Miles de tesistas ya avanzan con el Pack Investigador Pro.
      </p>
      <div class="mt-4 flex flex-wrap justify-center gap-2 text-xs font-semibold text-slate-500">
        <span class="rounded-full bg-white px-3 py-1 border dark:bg-slate-800">Pregrado</span>
        <span class="rounded-full bg-white px-3 py-1 border dark:bg-slate-800">Maestría</span>
        <span class="rounded-full bg-white px-3 py-1 border dark:bg-slate-800">Doctorado</span>
        <span class="rounded-full bg-white px-3 py-1 border dark:bg-slate-800">Ingeniería</span>
        <span class="rounded-full bg-white px-3 py-1 border dark:bg-slate-800">Salud</span>
        <span class="rounded-full bg-white px-3 py-1 border dark:bg-slate-800">Educación</span>
        <span class="rounded-full bg-white px-3 py-1 border dark:bg-slate-800">Derecho</span>
      </div>
    </div>
  </section>
</Layout>
