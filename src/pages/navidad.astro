---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import SnowCanvas from "../components/navidad/SnowCanvas.astro";
import NavidadHero from "../components/navidad/NavidadHero.astro";
import NavidadPremio from "../components/navidad/NavidadPremio.astro";
import NavidadCanastas from "../components/navidad/NavidadCanastas.astro";
import NavidadPasos from "../components/navidad/NavidadPasos.astro";
import NavidadComunidad from "../components/navidad/NavidadComunidad.astro";
import NavidadForm from "../components/navidad/NavidadForm.astro";
import NavidadGrupo from "../components/navidad/NavidadGrupo.astro";
import NavidadBasesFaq from "../components/navidad/NavidadBasesFaq.astro";
import { NAVIDAD, NAVIDAD_CIERRE, NAVIDAD_FAQ, NAVIDAD_MEDIA } from "../config/navidad";
import { SITE } from "../site.config";

const eventLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: "Sorteo de 50 Canastas Navideñas — HispanoTech",
  description: "Sorteo gratuito de 50 canastas navideñas para estudiantes, egresados y profesionales de la comunidad de investigación HispanoTech.",
  startDate: NAVIDAD.fechaSorteo,
  eventAttendanceMode: "https://schema.org/OnlineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  location: { "@type": "VirtualLocation", url: `${SITE.url}/navidad` },
  image: [`${SITE.url}/navidad/og-navidad.jpg`],
  organizer: { "@type": "Organization", name: "HispanoTech", url: SITE.url },
  isAccessibleForFree: true,
};
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: NAVIDAD_FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<Layout
  title="Sorteo de 50 Canastas Navideñas"
  description="¡Esta Navidad, HispanoTech premia tu esfuerzo académico! Inscríbete gratis, únete a la comunidad y participa por una de las 50 canastas navideñas."
  keywords={["sorteo navidad", "canastas navideñas", "sorteo canastas navideñas peru", "hispanotech", "tesis ia", "comunidad de investigación"]}
  image={`${SITE.url}/navidad/og-navidad.jpg`}
  imageAlt="Canasta navideña 3D junto a un árbol de Navidad iluminado — Sorteo de 50 canastas HispanoTech"
  jsonLd={[eventLd, faqLd]}
>
  <SnowCanvas />
  <main class="navidad">
    <NavidadHero />
    <NavidadPremio />
    <NavidadCanastas />
    <NavidadPasos />
    <NavidadComunidad />
    <NavidadForm />
    <NavidadGrupo />
    <NavidadBasesFaq />

    <!-- Cierre -->
    <section id="cierre" class="relative isolate overflow-hidden py-24 text-center text-white md:py-32">
      <!-- Fondo animado 3D (Blender): solo se descarga y reproduce cuando la sección está en pantalla -->
      <video
        id="cta-video"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-[68%_center]"
        muted
        loop
        playsinline
        preload="none"
        poster={NAVIDAD_MEDIA.ctaPoster}
        aria-hidden="true"
      >
        <source src={NAVIDAD_MEDIA.ctaVideoWebm} type="video/webm" />
        <source src={NAVIDAD_MEDIA.ctaVideoMp4} type="video/mp4" />
      </video>
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-[#050d22]/80 via-[#050d22]/55 to-[#050d22]/85"></div>
      <div class="mx-auto max-w-3xl px-6">
        <h2 class="reveal font-display text-4xl font-bold leading-tight tracking-tight md:text-5xl">{NAVIDAD_CIERRE.titulo}</h2>
        <p class="reveal mt-4 text-lg text-slate-200" style="--reveal-delay:100ms">{NAVIDAD_CIERRE.texto}</p>
        <div class="reveal mt-8 flex flex-col justify-center gap-3 sm:flex-row" style="--reveal-delay:180ms">
          <a href="#formulario" class="inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-amber-300 to-amber-500 px-8 py-4 font-display text-sm font-bold uppercase tracking-wide text-[#0B1D3A] shadow-lg shadow-amber-500/30 transition hover:-translate-y-0.5">
            <Icon name="lucide:gift" class="h-5 w-5" /> Quiero participar
          </a>
          <a href="#formulario" data-wa-grupo class="inline-flex items-center justify-center gap-2 rounded-full bg-[#25D366] px-8 py-4 font-display text-sm font-bold uppercase tracking-wide text-white transition hover:-translate-y-0.5 hover:bg-[#1ebe5b]">
            <Icon name="simple-icons:whatsapp" class="h-5 w-5" /> Unirme al grupo de WhatsApp
          </a>
        </div>
        <p class="mt-10 text-sm text-slate-300">¡Felices fiestas te desea toda la comunidad HispanoTech! 🎄</p>
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  /* Inclinación 3D al pasar el mouse (tarjetas e imágenes 3D) */
  .tilt-3d {
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.25s ease-out;
    transform-style: preserve-3d;
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .tilt-3d { transform: none !important; }
    .navidad .animate-float { animation: none; }
  }
</style>

<script>
  // Video de fondo del CTA: reproducir solo mientras está visible (ahorra datos y batería)
  const cta = document.getElementById("cta-video") as HTMLVideoElement | null;
  const conn = (navigator as any).connection;
  if (cta && !window.matchMedia("(prefers-reduced-motion: reduce)").matches && !conn?.saveData) {
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { cta.preload = "auto"; cta.play().catch(() => {}); } else cta.pause();
    }, { threshold: 0.2 }).observe(cta);
  }

  // Tilt 3D solo en dispositivos con mouse
  if (window.matchMedia("(hover: hover) and (pointer: fine)").matches &&
      !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>(".tilt-3d").forEach((el) => {
      el.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        el.style.setProperty("--ry", `${x * 10}deg`);
        el.style.setProperty("--rx", `${-y * 10}deg`);
      });
      el.addEventListener("pointerleave", () => {
        el.style.setProperty("--ry", "0deg");
        el.style.setProperty("--rx", "0deg");
      });
    });
  }
</script>
