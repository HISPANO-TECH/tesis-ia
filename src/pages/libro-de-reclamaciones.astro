---
import Layout from "../layouts/Layout.astro";
import { EMPRESA } from "../config/navidad";
const input = "mt-1 w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-[15px] text-slate-900 outline-none focus:border-amber-400 focus:ring-4 focus:ring-amber-300/30 dark:border-slate-600 dark:bg-slate-900 dark:text-white";
const label = "text-sm font-semibold text-slate-800 dark:text-slate-100";
const h2 = "font-display text-lg font-bold text-[#0B1D3A] dark:text-white";
---

<Layout campana title="Libro de Reclamaciones" description="Libro de Reclamaciones virtual de Mate Fácil E.I.R.L. para tesis-ia.com.">
  <main>
    <header class="bg-[#0B1D3A] py-12 text-white">
      <div class="mx-auto max-w-3xl px-6">
        <h1 class="font-display text-[32px] font-bold leading-tight md:text-[42px]">Libro de Reclamaciones</h1>
        <p class="mt-3 text-sm text-blue-100">{EMPRESA.razonSocial} · RUC {EMPRESA.ruc} · {EMPRESA.domicilio}</p>
      </div>
    </header>
    <div class="bg-slate-50 py-10 dark:bg-slate-950">
      <form id="libro" class="mx-auto max-w-3xl space-y-8 px-6">
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px]" />
        <section>
          <h2 class={h2}>1. Datos del consumidor</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <label class={`${label} sm:col-span-2`}>Nombres y apellidos<input name="nombre" required minlength="5" maxlength="120" autocomplete="name" class={input} /></label>
            <label class={label}>DNI o carné de extranjería<input name="documento" required pattern="[0-9A-Za-z]{8,12}" maxlength="12" class={input} /></label>
            <label class={label}>Teléfono<input name="telefono" type="tel" required minlength="7" maxlength="15" class={input} /></label>
            <label class={`${label} sm:col-span-2`}>Domicilio<input name="domicilio" required minlength="5" maxlength="200" class={input} /></label>
            <label class={`${label} sm:col-span-2`}>Correo electrónico<input name="email" type="email" required maxlength="160" class={input} /></label>
            <label class={`${label} sm:col-span-2`}>Padre, madre o apoderado (solo si eres menor de edad)<input name="apoderado" maxlength="120" class={input} /></label>
          </div>
        </section>
        <section>
          <h2 class={h2}>2. Bien contratado</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <label class={label}>Tipo<select name="bien" required class={input}><option value="">Selecciona</option><option>Producto</option><option>Servicio</option></select></label>
            <label class={label}>Monto reclamado en soles (opcional)<input name="monto" inputmode="decimal" maxlength="20" class={input} /></label>
            <label class={`${label} sm:col-span-2`}>Descripción<input name="descripcion" required minlength="5" maxlength="300" class={input} /></label>
          </div>
        </section>
        <section>
          <h2 class={h2}>3. Reclamo o queja</h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300"><strong>Reclamo:</strong> disconformidad con el producto o servicio. <strong>Queja:</strong> malestar por la atención recibida.</p>
          <div class="mt-4 grid gap-4">
            <label class={label}>Tipo<select name="tipo" required class={input}><option value="">Selecciona</option><option>Reclamo</option><option>Queja</option></select></label>
            <label class={label}>Detalle<textarea name="detalle" required minlength="5" maxlength="3000" rows="5" class={input}></textarea></label>
            <label class={label}>Qué solicitas<textarea name="pedido" required minlength="5" maxlength="2000" rows="3" class={input}></textarea></label>
          </div>
        </section>
        <p class="text-sm text-slate-600 dark:text-slate-300">El proveedor responderá en un plazo no mayor de 15 días hábiles. Formular un reclamo no impide acudir a otras vías de solución de controversias ni es requisito previo para presentar una denuncia ante el Indecopi.</p>
        <button type="submit" class="rounded-full bg-[#0B1D3A] px-8 py-3.5 font-display text-sm font-bold uppercase tracking-wide text-white hover:bg-[#1e3a8a] disabled:opacity-60 dark:bg-amber-400 dark:text-[#0B1D3A]">Enviar hoja</button>
        <p id="libro-estado" role="status" aria-live="polite" class="hidden"></p>
      </form>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById("libro") as HTMLFormElement;
  const estado = document.getElementById("libro-estado")!;
  const decir = (t: string, error: boolean) => {
    estado.textContent = t;
    estado.className = "rounded-xl px-4 py-3 text-sm " + (error ? "bg-red-50 text-red-700" : "bg-emerald-50 text-emerald-800");
  };
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = form.querySelector("button")!;
    btn.disabled = true;
    try {
      const res = await fetch("https://tesis-ia.com/api/reclamaciones.php", { method: "POST", body: new FormData(form) });
      const j = await res.json();
      if (j.ok) {
        form.reset();
        decir(`Registramos tu hoja ${j.numero} el ${j.fecha}. ` + (j.correo ? "Enviamos una copia a tu correo." : "Guarda este número: no pudimos enviarte la copia por correo."), false);
      } else decir(j.error || "Revisa los datos.", true);
    } catch {
      decir("No pudimos registrar tu hoja. Inténtalo de nuevo o escribe a informes@tesis-ia.com.", true);
    } finally {
      btn.disabled = false;
    }
  });
</script>
