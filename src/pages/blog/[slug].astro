---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import { SITE } from "../../site.config";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const postDate = post.data.date.toISOString();
const updatedDate = (post.data.updated ?? post.data.date).toISOString();
const postUrl = `${SITE.url}/blog/${post.id}/`;

// Tiempo de lectura real (≈200 palabras/min) en lugar de un valor fijo.
const words = post.body?.trim().split(/\s+/).length ?? 0;
const readingTime = Math.max(2, Math.round(words / 200));

// Índice de contenidos con los H2 del artículo: mejora UX y habilita
// los "sitelinks" de saltos internos en Google.
const toc = headings.filter((h) => h.depth === 2);

// Artículos relacionados: primero los declarados en frontmatter, luego los que
// comparten tags o categoría. Enlazado interno = distribución de autoridad.
const allPosts = (await getCollection("blog")).filter((p) => !p.data.draft && p.id !== post.id);
const manual = post.data.related
  .map((slug) => allPosts.find((p) => p.id === slug))
  .filter((p): p is (typeof allPosts)[number] => Boolean(p));
const scored = allPosts
  .filter((p) => !manual.includes(p))
  .map((p) => ({
    post: p,
    score:
      p.data.tags.filter((t) => post.data.tags.includes(t)).length +
      (p.data.category === post.data.category ? 1 : 0),
  }))
  .sort((a, b) => b.score - a.score || b.post.data.date.valueOf() - a.post.data.date.valueOf())
  .map((s) => s.post);
const related = [...manual, ...scored].slice(0, 3);

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: postDate,
  dateModified: updatedDate,
  inLanguage: "es",
  wordCount: words,
  keywords: [...post.data.keywords, ...post.data.tags].join(", "),
  articleSection: post.data.category,
  author: { "@type": "Organization", name: "Tesis IA", url: SITE.url },
  publisher: {
    "@type": "Organization",
    name: "Tesis IA",
    logo: { "@type": "ImageObject", url: SITE.organization.logo },
  },
  image: post.data.image,
  mainEntityOfPage: postUrl,
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE.url}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE.url}/blog/` },
    { "@type": "ListItem", position: 3, name: post.data.title, item: postUrl },
  ],
};

const faqLd =
  post.data.faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: post.data.faq.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      }
    : null;

const jsonLd = [articleLd, breadcrumbLd, ...(faqLd ? [faqLd] : [])];
const fmt = (d: Date) => d.toLocaleDateString("es-PE", { dateStyle: "long" });
---

<Layout
  title={post.data.title}
  description={post.data.description}
  keywords={[...post.data.keywords, ...post.data.tags]}
  image={post.data.image}
  imageAlt={post.data.title}
  type="article"
  publishedTime={postDate}
  jsonLd={jsonLd}
>
  <article class="bg-white dark:bg-slate-950">
    <div class="relative overflow-hidden bg-[#0B1D3A] py-14">
      <div class="absolute inset-0">
        <img src={post.data.image} alt={post.data.title} class="parallax-bg h-full w-full object-cover opacity-40 scale-105" />
        <div class="absolute inset-0 bg-gradient-to-br from-[#0B1D3A]/90 via-[#1e3a8a]/75 to-[#0B1D3A]/85"></div>
        <div id="post-shine" class="absolute inset-0 opacity-0 transition duration-500" style="background: radial-gradient(700px circle at var(--mx,50%) var(--my,50%), rgba(245,158,11,0.2), transparent 45%);"></div>
      </div>
      <div class="relative mx-auto max-w-3xl px-6">
        <!-- Breadcrumb visible (coincide con el BreadcrumbList de schema.org) -->
        <nav aria-label="Migas de pan" class="flex flex-wrap items-center gap-1.5 text-xs font-semibold text-blue-200/80">
          <a href="/" class="hover:text-amber-300">Inicio</a>
          <Icon name="lucide:chevron-right" class="h-3.5 w-3.5 opacity-60" />
          <a href="/blog" class="hover:text-amber-300">Blog</a>
          <Icon name="lucide:chevron-right" class="h-3.5 w-3.5 opacity-60" />
          <span class="text-amber-200/70">{post.data.category}</span>
        </nav>
        <div class="mt-5 inline-flex rounded-full bg-amber-400 px-3 py-1 text-xs font-bold uppercase tracking-widest text-[#0B1D3A]">{post.data.category}</div>
        <h1 class="mt-4 font-display text-[30px] font-bold leading-none tracking-tight text-white md:text-[42px]">{post.data.title}</h1>
        <p class="mt-4 max-w-2xl text-blue-100">{post.data.description}</p>
        <div class="mt-6 flex flex-wrap items-center gap-3 text-xs text-blue-200/70">
          <span class="flex items-center gap-1.5"><Icon name="lucide:calendar" class="h-3.5 w-3.5" /> {fmt(post.data.date)}</span>
          <span>·</span> <span class="flex items-center gap-1.5"><Icon name="lucide:user" class="h-3.5 w-3.5" /> {post.data.author}</span>
          <span>·</span> <span class="flex items-center gap-1.5"><Icon name="lucide:clock-3" class="h-3.5 w-3.5" /> {readingTime} min de lectura</span>
          {post.data.updated && (
            <>
              <span>·</span>
              <span class="flex items-center gap-1.5 text-amber-200/80"><Icon name="lucide:refresh-cw" class="h-3.5 w-3.5" /> Actualizado el {fmt(post.data.updated)}</span>
            </>
          )}
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-3xl px-6 py-10">
      {toc.length > 2 && (
        <nav aria-label="Índice del artículo" class="mb-8 rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900">
          <h2 class="flex items-center gap-2 font-display text-sm font-bold uppercase tracking-widest text-[#0B1D3A] dark:text-amber-300">
            <Icon name="lucide:list-checks" class="h-4 w-4" /> Contenido del artículo
          </h2>
          <ol class="mt-3 grid gap-1.5 text-sm">
            {toc.map((h, i) => (
              <li>
                <a href={`#${h.slug}`} class="flex gap-2 rounded-lg px-2 py-1 text-slate-600 transition hover:bg-white hover:text-[#1e3a8a] dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-amber-300">
                  <span class="font-bold text-amber-600">{i + 1}.</span> <span>{h.text}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="prose prose-slate max-w-none dark:prose-invert prose-headings:font-display prose-headings:tracking-tight prose-headings:text-[#0B1D3A] dark:prose-headings:text-white prose-a:text-[#1e3a8a] dark:prose-a:text-amber-300 prose-strong:text-[#0B1D3A] dark:prose-strong:text-amber-200">
        <Content />
      </div>

      {post.data.faq.length > 0 && (
        <section class="mt-12" aria-labelledby="faq-articulo">
          <h2 id="faq-articulo" class="font-display text-2xl font-bold tracking-tight text-[#0B1D3A] dark:text-white">
            Preguntas frecuentes
          </h2>
          <div class="mt-4 rounded-[20px] border border-slate-200 bg-white p-2 shadow-sm dark:border-slate-800 dark:bg-slate-900 md:p-3">
            {post.data.faq.map((f) => (
              <details class="group border-b border-slate-100 last:border-0 dark:border-slate-800">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-4 py-4 text-left font-display text-[15px] font-bold leading-snug text-slate-800 hover:text-[#1e3a8a] dark:text-slate-100 dark:hover:text-amber-300 [&::-webkit-details-marker]:hidden">
                  <h3 class="m-0 flex-1 font-display text-[15px] font-bold leading-snug">{f.q}</h3>
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white text-[#1e3a8a] transition group-open:rotate-45 group-open:border-amber-400 group-open:bg-amber-400 group-open:text-[#0B1D3A] dark:border-slate-700 dark:bg-slate-800">+</span>
                </summary>
                <p class="px-4 pb-4 text-[14px] leading-relaxed text-slate-600 dark:text-slate-300">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <div class="mt-10 overflow-hidden rounded-2xl border border-amber-200 bg-gradient-to-br from-amber-50 to-white p-[1px] dark:from-amber-800/30 dark:to-slate-800">
        <div class="rounded-[15px] bg-gradient-to-br from-amber-50 to-white p-6 dark:from-amber-950/20 dark:to-slate-900">
          <div class="flex items-start gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-400 text-[#0B1D3A]"><Icon name="lucide:lightbulb" class="h-5 w-5" /></span>
            <div>
              <h2 class="font-display text-lg font-bold tracking-tight text-[#0B1D3A] dark:text-white">¿Quieres aplicar esto a tu tesis?</h2>
              <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                El <a href="/#pack" class="font-semibold text-[#1e3a8a] underline underline-offset-2 dark:text-amber-300">Pack IAs Investigador Pro</a> reúne ChatGPT Pro, Claude Max, Gemini Ultra, Perplexity Pro, Turnitin, NotebookLM y más, con prompts, plantillas y revisión de capítulo. Acompañamiento ético, no suplantación.
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                <a href="/#pack" class="inline-flex items-center gap-2 rounded-full bg-[#0B1D3A] px-5 py-2.5 text-sm font-bold uppercase tracking-wide text-white hover:bg-black">Ver el Pack <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
                <a href="/#planes" class="inline-flex items-center gap-2 rounded-full bg-amber-400 px-5 py-2.5 text-sm font-bold uppercase tracking-wide text-[#0B1D3A] hover:bg-amber-300">Planes desde $20</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-2">
        {post.data.tags.map((t) => (
          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300">#{t}</span>
        ))}
      </div>

      {related.length > 0 && (
        <section class="mt-12" aria-labelledby="relacionados">
          <h2 id="relacionados" class="font-display text-2xl font-bold tracking-tight text-[#0B1D3A] dark:text-white">Sigue leyendo</h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Guías relacionadas para no perder el hilo de tu investigación.</p>
          <div class="mt-5 grid gap-4 sm:grid-cols-3">
            {related.map((r) => (
              <a href={`/blog/${r.id}`} class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:border-amber-300 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900">
                <div class="relative h-28 overflow-hidden">
                  <img src={r.data.image} alt={r.data.title} loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-110" />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#0B1D3A]/70 to-transparent"></div>
                  <span class="absolute bottom-2 left-2 rounded-full bg-amber-400 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-[#0B1D3A]">{r.data.category}</span>
                </div>
                <div class="flex flex-1 flex-col p-4">
                  <h3 class="font-display text-[14px] font-bold leading-snug text-[#0B1D3A] group-hover:text-[#1e3a8a] dark:text-white line-clamp-3">{r.data.title}</h3>
                  <span class="mt-3 inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-widest text-amber-600">Leer <Icon name="lucide:arrow-right" class="h-3 w-3 transition group-hover:translate-x-1" /></span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <div class="mt-8 flex items-center justify-between border-t border-slate-200 pt-6 dark:border-slate-800">
        <a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-bold text-[#1e3a8a] hover:text-[#0B1D3A] dark:text-amber-300"><Icon name="lucide:arrow-left" class="h-4 w-4" /> Más artículos</a>
        <a href="/#contacto" class="inline-flex items-center gap-2 rounded-full bg-[#0B1D3A] px-5 py-2.5 text-sm font-bold text-white hover:bg-black">Consulta gratuita <Icon name="lucide:send" class="h-4 w-4" /></a>
      </div>
    </div>
  </article>

  <script>
    const hero = document.querySelector("article > div.relative");
    const shine = document.getElementById("post-shine");
    const bg = document.querySelector(".parallax-bg");
    if (hero && shine) {
      hero.addEventListener("mousemove", (e) => {
        const rect = hero.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        shine.style.setProperty("--mx", `${x}%`);
        shine.style.setProperty("--my", `${y}%`);
        shine.style.opacity = "1";
      });
      hero.addEventListener("mouseleave", () => (shine.style.opacity = "0"));
    }
    if (bg && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      window.addEventListener("scroll", () => {
        const y = window.scrollY * 0.15;
        bg.style.transform = `translateY(${y}px) scale(1.05)`;
      }, { passive: true });
    }
  </script>

  <style>
    details[open] summary span:last-child { transform: rotate(45deg); }
  </style>
</Layout>
