---
// Lead magnet "Banco de temas de tesis 2027-2030". El formulario guarda el registro y descarga el PDF de la
// carrera (api/banco-temas.php). noIndex y fuera del menú hasta validar los temas.
// Cifras y muestra: src/data/banco-temas.json (scripts/banco-temas/exportar.py).
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import banco from "../data/banco-temas.json";

const num = (n: number) => String(n).replace(/\B(?=(\d{3})+$)/g, n >= 10000 ? " " : "");
const pct = (n: number) => Math.round((n / banco.total) * 100);
const alcance = [
  { k: "Perú", n: banco.impacto["Perú"], c: "bg-amber-400" },
  { k: "Latam", n: banco.impacto.Latam, c: "bg-blue-400" },
  { k: "Global", n: banco.impacto.Global, c: "bg-slate-300" },
];
// POR CONFIRMAR: número del chatbot de Hispano Tech (mismo valor en scripts/banco-temas/generar_pdfs.py)
const CHATBOT = { texto: "+51 992 005 096", link: "https://wa.me/51992005096" };
const SITUACIONES = ["En cero, recién iniciando", "Plan de tesis aprobado", "Plan aprobado y avanzando el informe", "Levantamiento de observaciones"];
const ACCESO: Record<string, string> = { bajo: "Datos de acceso fácil", medio: "Datos de acceso medio", alto: "Datos de acceso difícil" };
const f = banco.ficha;
const lista = (s: string) => s.split(";").map((x) => x.trim()).filter(Boolean);
const campos = [
  ["lucide:variable", "Variables"], ["lucide:compass", "Enfoque metodológico"], ["lucide:target", "Objetivo general"], ["lucide:list-checks", "Objetivos específicos"],
  ["lucide:flask-conical", "Metodología"], ["lucide:database", "Datos"], ["lucide:cpu", "Procesamiento"], ["lucide:globe", "Alcance y acceso"],
];
const pasos = [
  ["Elige tu carrera", "Hay 13 carreras, con 100 temas cada una."],
  ["Completa el formulario", "Son cinco datos. No pedimos DNI."],
  ["Descarga tu PDF", "Se descarga al instante con los 100 temas de tu carrera."],
];
const usos = [
  ["icono-idea", 240, 353, "No tienes tema", "Recorre las categorías de tu carrera y descarta rápido."],
  ["icono-balanza", 240, 165, "Dudas entre varios", "Compara qué datos pide cada tema y qué tan difícil es conseguirlos."],
  ["icono-plan", 240, 307, "Vas a armar tu plan", "Parte de variables, objetivos y metodología ya planteados."],
] as const;
const faqs = [
  ["¿Cómo recibo el banco?", "Al enviar el formulario se descarga un PDF con los 100 temas de tu carrera, cada uno con su ficha."],
  ["¿Puedo usar un tema tal como está?", "Úsalo como punto de partida. Antes de presentarlo, revisa que no se haya investigado ya, adáptalo a tu contexto y consúltalo con tu asesor."],
  ["¿Los temas están aprobados por mi universidad?", "No. Cada universidad tiene sus líneas de investigación y su propio proceso de aprobación."],
  ["¿Todos los temas traen la ficha completa?", `${num(banco.completos)} de ${num(banco.total)} la traen completa. El resto, de Ingeniería Civil e Ingeniería Industrial, incluye menos campos.`],
  ["¿Cómo se armó el banco?", "Las propuestas se generaron con inteligencia artificial a partir de tendencias estimadas por carrera."],
  ["¿Puedo recibir ayuda para desarrollar mi tema?", `Sí. Escríbenos por WhatsApp al ${CHATBOT.texto}.`],
];
const input = "mt-1 w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-[15px] text-slate-900 outline-none transition focus:border-amber-400 focus:ring-4 focus:ring-amber-300/30 dark:border-slate-600 dark:bg-slate-900 dark:text-white";
const label = "block text-sm font-semibold text-slate-800 dark:text-slate-100";
const h2 = "font-display text-3xl font-bold leading-tight tracking-tight text-[#0B1D3A] dark:text-white md:text-[42px]";
---

<Layout
  noIndex
  title="Banco de temas de tesis 2027-2030"
  description="1300 ideas de tesis para 13 carreras, con variables, objetivos, metodología y fuentes de datos. Descarga en PDF los temas de tu carrera."
>
  <main class="banco">
    <!-- 1. Portada -->
    <section id="portada" class="relative overflow-hidden bg-[#071330] text-white">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <div class="brillo absolute -left-40 -top-40 h-[520px] w-[520px] rounded-full bg-blue-600/30 blur-[110px]"></div>
        <div class="brillo absolute -bottom-48 right-0 h-[520px] w-[520px] rounded-full bg-amber-500/20 blur-[120px]" style="animation-delay:-4s"></div>
        <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(ellipse_at_center,black_35%,transparent_75%)]"></div>
      </div>
      <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-6 py-12 lg:grid-cols-[1.1fr_0.9fr] lg:py-16">
        <div>
          <p class="entrada inline-flex items-center gap-2 rounded-full border border-amber-300/30 bg-amber-300/10 px-3 py-1 text-xs font-bold uppercase tracking-widest text-amber-300">
            <Icon name="lucide:sparkles" class="h-3.5 w-3.5" /> Banco de temas 2027-2030
          </p>
          <h1 class="entrada mt-5 font-display text-[38px] font-bold leading-[1.02] tracking-tight md:text-[58px]" style="--d:80ms">
            Encuentra tu tema de tesis entre <span class="bg-gradient-to-r from-amber-200 via-amber-300 to-amber-500 bg-clip-text text-transparent">{num(banco.total)} ideas</span>
          </h1>
          <p class="entrada mt-4 max-w-xl text-lg leading-relaxed text-blue-100" style="--d:160ms">
            Para {banco.carreras.length} carreras, con variables, objetivos, metodología y dónde conseguir los datos.
          </p>
          <ul class="entrada mt-5 flex flex-wrap gap-2 text-sm font-semibold" style="--d:240ms">
            {[["lucide:graduation-cap", `${banco.carreras.length} carreras`], ["lucide:lightbulb", "100 ideas por carrera"], ["lucide:file-down", "Descarga en PDF"]].map(([ic, t]) => (
              <li class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/[0.06] px-3 py-1.5 backdrop-blur"><Icon name={ic} class="h-4 w-4 text-amber-300" />{t}</li>
            ))}
          </ul>
          <div class="entrada relative mx-auto mt-6 max-w-[620px]" style="--d:320ms">
            <div aria-hidden="true" class="absolute inset-x-[12%] bottom-[6%] h-[20%] rounded-[50%] bg-black/40 blur-2xl"></div>
            <img
              data-parallax
              src="/banco/banco-portada-1200.webp"
              srcset="/banco/banco-portada-640.webp 640w, /banco/banco-portada-1200.webp 1200w"
              sizes="(min-width: 1024px) 620px, 92vw"
              width="1200" height="747" fetchpriority="high" decoding="async"
              alt="Libro abierto en 3D con birrete, bombilla encendida y fichas de temas flotando"
              class="flotar relative w-full drop-shadow-[0_30px_40px_rgba(0,0,0,0.45)]"
            />
          </div>
        </div>

        <form data-banco data-api="https://tesis-ia.com" id="descargar" novalidate class="entrada scroll-mt-32 rounded-[28px] bg-white p-6 text-slate-900 shadow-2xl shadow-black/40 ring-1 ring-white/10 dark:bg-slate-800 md:p-8" style="--d:200ms">
          <p class="font-display text-2xl font-bold text-[#0B1D3A] dark:text-white">Descarga los temas de tu carrera</p>
          <div class="mt-5 space-y-4">
            <div><label for="b-carrera" class={label}>Carrera</label>
              <select id="b-carrera" name="carrera" required class={input}><option value="">Selecciona</option>{banco.carreras.map((c) => <option value={c.slug}>{c.nombre}</option>)}</select></div>
            <div><label for="b-nombre" class={label}>Nombres y apellidos</label><input id="b-nombre" name="nombre" required autocomplete="name" maxlength="120" class={input} /></div>
            <div><label for="b-correo" class={label}>Correo electrónico</label><input id="b-correo" name="correo" type="email" required autocomplete="email" maxlength="160" class={input} /></div>
            <div><label for="b-cel" class={label}>WhatsApp</label><input id="b-cel" name="celular" type="tel" inputmode="numeric" required placeholder="9XX XXX XXX" maxlength="15" class={input} /></div>
            <div><label for="b-situacion" class={label}>Situación de tu tesis</label>
              <select id="b-situacion" name="situacion" required class={input}><option value="">Selecciona</option>{SITUACIONES.map((x) => <option>{x}</option>)}</select></div>
          </div>
          <div class="mt-4 space-y-3 text-xs leading-relaxed text-slate-700 dark:text-slate-200">
            <label class="flex gap-3"><input type="checkbox" name="privacidad" required class="mt-0.5 h-4 w-4 shrink-0 accent-amber-500" /><span>Autorizo el uso de mis datos para recibir el banco, según la <a href="/privacidad/" class="font-semibold text-[#1e3a8a] underline dark:text-amber-300">política de privacidad</a>.</span></label>
            <label class="flex gap-3"><input type="checkbox" name="promos" class="mt-0.5 h-4 w-4 shrink-0 accent-amber-500" /><span><strong>Opcional.</strong> Acepto recibir información de cursos y servicios. Puedo retirar mi consentimiento cuando quiera.</span></label>
          </div>
          <button type="submit" class="brillo-boton mt-5 w-full rounded-full bg-gradient-to-r from-amber-300 to-amber-500 px-6 py-3.5 font-display text-sm font-bold uppercase tracking-wide text-[#0B1D3A] shadow-lg shadow-amber-500/30 transition hover:-translate-y-0.5 hover:shadow-amber-500/50 disabled:opacity-70">Descargar mis 100 temas en PDF</button>
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px]" />
          <p data-estado role="status" aria-live="polite" class="mt-3 hidden rounded-xl bg-red-50 px-4 py-2.5 text-sm text-red-700"></p>
        </form>
        <div id="gracias" tabindex="-1" class="hidden rounded-[28px] bg-white p-8 text-center text-slate-900 shadow-2xl dark:bg-slate-800 dark:text-white">
          <Icon name="lucide:file-down" class="mx-auto h-14 w-14 text-emerald-600" />
          <p class="mt-4 font-display text-2xl font-bold">Tu descarga empezó</p>
          <p class="mt-2 text-slate-600 dark:text-slate-300">Es el banco de <strong data-carrera></strong>. Si no se descargó, usa el botón.</p>
          <a data-descarga class="mt-5 inline-flex items-center gap-2 rounded-full bg-amber-400 px-6 py-3 text-sm font-bold text-[#0B1D3A] hover:bg-amber-300"><Icon name="lucide:download" class="h-4 w-4" /> Descargar de nuevo</a>
          <p class="mt-6 text-sm text-slate-600 dark:text-slate-300">¿Quieres ayuda con tu tema? <a href={CHATBOT.link} target="_blank" rel="noopener" class="font-bold text-emerald-700 underline dark:text-emerald-400">Escríbenos por WhatsApp</a></p>
        </div>
      </div>
    </section>

    <!-- 2. Cifras -->
    <section id="cifras" class="bg-white py-14 dark:bg-slate-950">
      <div class="mx-auto max-w-7xl px-6">
        <dl class="grid gap-8 sm:grid-cols-3">
          {[[num(banco.total), "ideas de tesis"], [banco.carreras.length, "carreras, con 100 ideas cada una"], [banco.categorias, "categorías, 10 por carrera"]].map(([n, t]) => (
            <div class="reveal border-l-4 border-amber-400 pl-5"><dt class="text-slate-600 dark:text-slate-300">{t}</dt><dd data-contar={String(n).replace(/\D/g, "")} class="order-first font-display text-5xl font-bold tabular-nums tracking-tight text-[#0B1D3A] dark:text-white">{n}</dd></div>
          ))}
        </dl>
        <div class="reveal mt-10" data-barras>
          <p class="font-semibold text-[#0B1D3A] dark:text-white">Alcance de las ideas</p>
          <div class="mt-3 flex h-12 overflow-hidden rounded-xl text-sm font-bold text-[#0B1D3A]">
            {alcance.map((a, k) => <div class={`barra flex items-center overflow-hidden whitespace-nowrap px-4 ${a.c}`} style={`--w:${(a.n / banco.total) * 100}%;--d:${k * 150}ms`}>{pct(a.n)} %</div>)}
          </div>
          <div class="mt-2 flex text-sm text-slate-600 dark:text-slate-300">
            {alcance.map((a) => <div class="px-1" style={`width:${(a.n / banco.total) * 100}%`}>{a.k}: {a.n}</div>)}
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Carreras y muestra -->
    <section id="carreras" class="bg-[#fffbeb] py-16 dark:bg-slate-900 md:py-20">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class:list={[h2, "reveal"]}>Elige tu carrera y mira una muestra</h2>
        <div class="mt-8 grid gap-6 lg:grid-cols-[320px_minmax(0,1fr)]">
          <div role="tablist" aria-label="Carreras" class="flex gap-2 overflow-x-auto pb-2 lg:block lg:space-y-1 lg:overflow-visible">
            {banco.carreras.map((c, i) => (
              <button type="button" role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}
                class="flex shrink-0 items-center gap-3 rounded-xl px-4 py-2.5 text-left text-sm font-semibold text-slate-700 transition hover:bg-amber-100 aria-selected:bg-[#0B1D3A] aria-selected:text-white lg:w-full dark:text-slate-200 dark:hover:bg-slate-800 dark:aria-selected:bg-amber-400 dark:aria-selected:text-[#0B1D3A]">
                <Icon name={`lucide:${c.icono}`} class="h-5 w-5 shrink-0" />{c.nombre}
              </button>
            ))}
          </div>
          <div>
            {banco.carreras.map((c, i) => (
              <div role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} hidden={i !== 0} data-nombre={c.nombre} class="panel">
                <ul class="divide-y divide-amber-200 overflow-hidden rounded-2xl border border-amber-200 bg-white dark:divide-slate-700 dark:border-slate-700 dark:bg-slate-800">
                  {c.muestra.map((t, k) => (
                    <li class="tema p-5 transition hover:bg-amber-50/60 dark:hover:bg-slate-700/40" style={`--d:${k * 70}ms`}>
                      <p class="text-sm text-slate-600 dark:text-slate-400">{t.categoria}</p>
                      <p class="mt-1 font-display text-lg font-bold leading-snug text-[#0B1D3A] dark:text-white">{t.titulo}</p>
                      <p class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm font-medium text-slate-700 dark:text-slate-300"><span class="inline-flex items-center gap-1.5"><Icon name="lucide:globe" class="h-4 w-4 text-amber-600" />{t.impacto}</span><span class="inline-flex items-center gap-1.5"><Icon name="lucide:database" class="h-4 w-4 text-amber-600" />{ACCESO[t.acceso]}</span></p>
                    </li>
                  ))}
                </ul>
                <p class="mt-5 font-semibold text-[#0B1D3A] dark:text-white">Las 10 categorías de {c.nombre}</p>
                <p class="mt-1 text-[15px] leading-relaxed text-slate-700 dark:text-slate-300">{c.categorias.join(" · ")}</p>
                <a href="#descargar" data-elegir={c.slug} class="mt-5 inline-flex items-center gap-2 rounded-full bg-[#0B1D3A] px-6 py-3 text-sm font-bold text-white hover:bg-[#1e3a8a] dark:bg-amber-400 dark:text-[#0B1D3A]"><Icon name="lucide:lock-open" class="h-4 w-4" /> Ver los otros {c.temas - c.muestra.length} temas</a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Ficha -->
    <section id="ficha" class="bg-white py-16 dark:bg-slate-950 md:py-20">
      <div class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <h2 class:list={[h2, "reveal"]}>Más que un título</h2>
          <p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-300">Las ideas vienen desarrolladas en una ficha, para que sepas qué implican antes de elegir.</p>
          <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-4">
            {campos.map(([ic, t], k) => <li class="reveal flex items-center gap-3 text-[15px] font-medium text-slate-800 dark:text-slate-200" style={`--reveal-delay:${k * 50}ms`}><Icon name={ic} class="h-5 w-5 shrink-0 text-amber-600" />{t}</li>)}
          </ul>
          <img src="/banco/banco-pdf-480.webp" srcset="/banco/banco-pdf-480.webp 480w, /banco/banco-pdf-900.webp 900w" sizes="(min-width: 1024px) 380px, 70vw"
            width="480" height="352" loading="lazy" decoding="async" alt="PDF del banco de temas en 3D con el logo de Hispano Tech"
            class="reveal flotar mx-auto mt-8 w-[70%] max-w-[380px] drop-shadow-[0_24px_30px_rgba(11,29,58,0.25)]" />
        </div>
        <article class="reveal reveal-right rounded-3xl border border-slate-200 bg-slate-50 p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900 md:p-8">
          <p class="text-sm text-slate-600 dark:text-slate-400">Ejemplo: {f.Carrera}</p>
          <h3 class="mt-1 font-display text-xl font-bold leading-snug text-[#0B1D3A] dark:text-white">{f["Título"]}</h3>
          <dl class="mt-5 space-y-4 text-[15px] leading-relaxed text-slate-700 dark:text-slate-300">
            <div><dt class="font-bold text-[#0B1D3A] dark:text-amber-300">Objetivo general</dt><dd>{f["Objetivo general"]}</dd></div>
            <div><dt class="font-bold text-[#0B1D3A] dark:text-amber-300">Variables</dt><dd>{lista(f.Variables).slice(0, 4).join(", ")} y {lista(f.Variables).length - 4} más.</dd></div>
            <div><dt class="font-bold text-[#0B1D3A] dark:text-amber-300">Metodología</dt><dd>{f["Metodología"]}</dd></div>
            <div><dt class="font-bold text-[#0B1D3A] dark:text-amber-300">Datos</dt><dd>{f.Datos}</dd></div>
          </dl>
          <p class="mt-5 border-t border-slate-200 pt-4 text-sm text-slate-600 dark:border-slate-700 dark:text-slate-400">La ficha también trae objetivos específicos, enfoque y procesamiento.</p>
        </article>
      </div>
    </section>

    <!-- 5. Para quién -->
    <section id="para-quien" class="bg-[#0B1D3A] py-16 text-white md:py-20">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="reveal font-display text-3xl font-bold tracking-tight md:text-[42px]">Te sirve si…</h2>
        <div class="mt-8 grid gap-8 md:grid-cols-3">
          {usos.map(([img, w, h, t, d], k) => (
            <div class="reveal group rounded-3xl border border-white/10 bg-white/[0.04] p-6 transition duration-300 hover:-translate-y-1.5 hover:border-amber-300/40 hover:bg-white/[0.07]" style={`--reveal-delay:${k * 110}ms`}>
              <div class="flex h-28 items-end"><img src={`/banco/${img}-240.webp`} width={w} height={h} loading="lazy" decoding="async" alt="" class="max-h-28 w-auto transition duration-500 group-hover:-translate-y-1 group-hover:rotate-[-4deg]" /></div>
              <h3 class="mt-5 font-display text-xl font-bold">{t}</h3><p class="mt-2 leading-relaxed text-blue-100">{d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Cómo funciona -->
    <section id="como-funciona" class="bg-white py-16 dark:bg-slate-950 md:py-20">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class:list={[h2, "reveal"]}>Cómo lo recibes</h2>
        <ol class="mt-8 grid gap-6 md:grid-cols-3">
          {pasos.map(([t, d], i) => (
            <li class="reveal flex gap-4" style={`--reveal-delay:${i * 120}ms`}><span class="flex h-12 w-12 shrink-0 shadow-lg shadow-amber-500/30 items-center justify-center rounded-2xl bg-amber-400 font-display text-xl font-bold text-[#0B1D3A]">{i + 1}</span><div><h3 class="font-display text-lg font-bold text-[#0B1D3A] dark:text-white">{t}</h3><p class="mt-1 text-slate-600 dark:text-slate-300">{d}</p></div></li>
          ))}
        </ol>
        <p class="reveal mt-10 max-w-3xl rounded-2xl border border-amber-300 bg-amber-50 p-5 text-[15px] leading-relaxed text-amber-950 dark:border-amber-700 dark:bg-amber-950/30 dark:text-amber-100"><strong>Úsalo con criterio.</strong> Son ideas de partida, no temas aprobados. Verifica antecedentes y acceso a los datos, y valida tu elección con tu asesor. La autoría de tu tesis es tuya.</p>
      </div>
    </section>

    <!-- 7. Preguntas -->
    <section id="preguntas" class="bg-[#fffbeb] py-16 dark:bg-slate-900 md:py-20">
      <div class="mx-auto max-w-4xl px-6">
        <h2 class:list={[h2, "reveal"]}>Preguntas frecuentes</h2>
        <div class="mt-7 divide-y divide-amber-200 dark:divide-slate-700">
          {faqs.map(([q, a], i) => (
            <details class="reveal group py-4" open={i === 0} style={`--reveal-delay:${i * 50}ms`}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-bold text-[#0B1D3A] dark:text-white">{q}<Icon name="lucide:plus" class="h-5 w-5 shrink-0 text-amber-600 transition group-open:rotate-45" /></summary>
              <p class="mt-2 leading-relaxed text-slate-700 dark:text-slate-300">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. Cierre -->
    <section id="cierre-banco" class="bg-gradient-to-r from-[#1e3a8a] to-[#0B1D3A] py-16 text-white">
      <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-6 md:flex-row md:items-center">
        <h2 class="reveal max-w-2xl font-display text-3xl font-bold leading-tight tracking-tight md:text-4xl">Tu próximo tema puede estar en las 100 ideas de tu carrera</h2>
        <a href="#descargar" class="reveal brillo-boton shrink-0 rounded-full bg-gradient-to-r from-amber-300 to-amber-500 px-8 py-4 shadow-lg shadow-amber-500/30 transition hover:-translate-y-0.5 font-display text-sm font-bold uppercase tracking-wide text-[#0B1D3A] hover:bg-amber-300">Descargar mis 100 temas</a>
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  /* Animaciones solo con transform/opacity: las maneja la GPU y no bloquean el scroll */
  .banco { overflow-x: clip; } /* las animaciones de entrada laterales no deben crear scroll horizontal */
  .banco .entrada { animation: entrada 0.8s cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: var(--d, 0ms); }
  @keyframes entrada { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
  .banco .flotar { animation: flotar 6s ease-in-out infinite; }
  @keyframes flotar { 0%, 100% { translate: 0 0; } 50% { translate: 0 -12px; } }
  .banco .brillo { animation: brillo 12s ease-in-out infinite alternate; }
  @keyframes brillo { from { transform: translate3d(0, 0, 0) scale(1); } to { transform: translate3d(40px, 30px, 0) scale(1.12); } }
  .banco [data-parallax] { transform: translate3d(var(--px, 0), var(--py, 0), 0); transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); will-change: transform; }
  .banco .barra { width: 0; transition: width 1.2s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms); }
  .banco [data-barras].is-visible .barra, html:not(.js) .banco .barra { width: var(--w); }
  .banco .panel:not([hidden]) .tema { animation: entrada 0.5s cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: var(--d, 0ms); }
  .banco .brillo-boton { position: relative; overflow: hidden; }
  .banco .brillo-boton::after { content: ""; position: absolute; inset: 0; background: linear-gradient(110deg, transparent 35%, rgba(255,255,255,0.55) 50%, transparent 65%); transform: translateX(-120%); animation: barrido 3.2s ease-in-out infinite 1.5s; }
  @keyframes barrido { 0%, 60% { transform: translateX(-120%); } 100% { transform: translateX(120%); } }
  @media (prefers-reduced-motion: reduce) {
    .banco .entrada, .banco .flotar, .banco .brillo, .banco .tema, .banco .brillo-boton::after { animation: none !important; }
    .banco .barra { transition: none; }
  }
</style>

<script>
  const reducido = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Cifras que cuentan hacia arriba al aparecer
  const contadores = document.querySelectorAll<HTMLElement>("[data-contar]");
  if (!reducido && "IntersectionObserver" in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      io.unobserve(e.target);
      const el = e.target as HTMLElement, fin = Number(el.dataset.contar), t0 = performance.now();
      const paso = (t: number) => {
        const p = Math.min(1, (t - t0) / 1200), v = Math.round(fin * (1 - Math.pow(1 - p, 3)));
        el.textContent = String(v);
        if (p < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    }), { threshold: 0.6 });
    contadores.forEach((c) => { c.textContent = "0"; io.observe(c); });
  }

  // Leve movimiento de la escena 3D con el mouse (solo en computadoras)
  const escena = document.querySelector<HTMLElement>("[data-parallax]");
  if (escena && !reducido && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    let raf = 0;
    document.getElementById("portada")!.addEventListener("pointermove", (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        escena.style.setProperty("--px", `${(e.clientX / innerWidth - 0.5) * -18}px`);
        escena.style.setProperty("--py", `${(e.clientY / innerHeight - 0.5) * -12}px`);
      });
    }, { passive: true });
  }

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".banco [role=tab]"));
  const ver = (i: number, foco = false) => tabs.forEach((t, k) => {
    t.setAttribute("aria-selected", String(k === i));
    t.tabIndex = k === i ? 0 : -1;
    document.getElementById(t.getAttribute("aria-controls")!)!.hidden = k !== i;
    if (k === i && foco) t.focus();
  });
  tabs.forEach((t, i) => {
    t.addEventListener("click", () => ver(i));
    t.addEventListener("keydown", (e) => {
      const d = ["ArrowDown", "ArrowRight"].includes(e.key) ? 1 : ["ArrowUp", "ArrowLeft"].includes(e.key) ? -1 : 0;
      if (d) { e.preventDefault(); ver((i + d + tabs.length) % tabs.length, true); }
    });
  });

  const form = document.querySelector<HTMLFormElement>("[data-banco]")!;
  const sel = form.querySelector<HTMLSelectElement>("[name=carrera]")!;
  document.querySelectorAll<HTMLElement>("[data-elegir]").forEach((a) => a.addEventListener("click", () => { sel.value = a.dataset.elegir!; }));

  const estado = form.querySelector<HTMLElement>("[data-estado]")!;
  const boton = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
  const avisar = (t: string) => { estado.textContent = t; estado.classList.remove("hidden"); };
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const cel = String(fd.get("celular")).replace(/\D/g, "").replace(/^51(?=9\d{8}$)/, "");
    fd.set("celular", cel);
    if (!form.checkValidity() || !/^9\d{8}$/.test(cel) || !String(fd.get("nombre")).trim().includes(" ")) {
      avisar("Completa todos los campos (nombres y apellidos, y un celular de 9 dígitos) y acepta la política de privacidad.");
      (form.querySelector<HTMLElement>(":invalid") || form.querySelector<HTMLElement>("[name=celular]"))?.focus();
      return;
    }
    estado.classList.add("hidden");
    boton.disabled = true;
    boton.textContent = "Preparando tu PDF…";
    try {
      const res = await fetch(`${form.dataset.api}/api/banco-temas.php`, { method: "POST", body: fd });
      if (!res.ok || !(res.headers.get("Content-Type") || "").includes("pdf")) {
        const j = await res.json().catch(() => null);
        avisar(j?.error || "No pudimos generar tu descarga. Inténtalo de nuevo en unos minutos.");
        return;
      }
      const url = URL.createObjectURL(await res.blob());
      const nombre = `banco-temas-tesis-${fd.get("carrera")}.pdf`;
      const a = Object.assign(document.createElement("a"), { href: url, download: nombre });
      document.body.append(a); a.click(); a.remove();
      const g = document.getElementById("gracias")!;
      g.querySelector("[data-carrera]")!.textContent = sel.selectedOptions[0].textContent;
      Object.assign(g.querySelector<HTMLAnchorElement>("[data-descarga]")!, { href: url, download: nombre });
      form.classList.add("hidden");
      g.classList.remove("hidden");
      g.focus();
    } catch {
      avisar("No pudimos conectar con el servidor. Revisa tu conexión e inténtalo de nuevo.");
    } finally {
      boton.disabled = false;
      boton.textContent = "Descargar mis 100 temas en PDF";
    }
  });
</script>
